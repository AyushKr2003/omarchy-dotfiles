#!/bin/bash

# omarchy:summary=Mount unmounted internal partitions, same flow as Nautilus

unmounted=()
labels=()

while IFS= read -r line; do
  name=$(echo "$line" | awk '{print $1}')
  fstype=$(echo "$line" | awk '{print $2}')
  label=$(echo "$line" | awk '{print $3}')
  size=$(echo "$line" | awk '{print $4}')

  # Skip whole disks (only process partitions)
  type=$(lsblk -no TYPE "$name" 2>/dev/null)
  [[ "$type" != "part" ]] && continue

  # Skip swap
  [[ "$fstype" == "swap" ]] && continue

  # Skip system partition types (EFI, MSR, BIOS boot)
  parttype=$(lsblk -no PARTTYPE "$name" 2>/dev/null)
  case "$parttype" in
    c12a7328-f81f-11d2-ba4b-00a0c93ec93b) continue ;; # EFI
    e3c9e316-0b5c-4db8-817d-f92df00215ae) continue ;; # MSR
    21686148-6449-6e6f-744e-656564454649) continue ;; # BIOS boot
  esac

  # Skip partitions that are already mounted (mountpoint is not empty)
  mountpoint=$(lsblk -no MOUNTPOINT "$name" 2>/dev/null | tr -d ' ')
  [[ -n "$mountpoint" ]] && continue

  # Build display label
  display="$name  $size"
  [[ -n "$label" ]] && display="$display  ($label)" || display="$display  ($fstype)"

  unmounted+=("$name")
  labels+=("$display")
done < <(lsblk -rpo NAME,FSTYPE,LABEL,SIZE,MOUNTPOINT | awk '$2!="" && $1!~/zram/ {print $1, $2, $3, $4}')

# Nothing to mount
if [[ ${#unmounted[@]} -eq 0 ]]; then
  gum style \
    --border normal \
    --padding "0 1" \
    --foreground 2 \
    "All partitions are already mounted."
  sleep 2
  exit 0
fi

# Show picker
selected=$(printf '%s\n' "${labels[@]}" | gum choose --header "Select partition to mount") || exit 1
device=$(echo "$selected" | awk '{print $1}')

gum style --foreground 3 "Mounting $device..."

# gio mount — exact same call Nautilus makes internally
if gio mount -d "$device"; then
  mountpoint=$(lsblk -no MOUNTPOINT "$device" 2>/dev/null)
  gum style \
    --border normal \
    --padding "0 1" \
    --foreground 2 \
    "Mounted at $mountpoint"
else
  gum style \
    --border normal \
    --padding "0 1" \
    --foreground 1 \
    "Failed to mount $device"
  exit 1
fi
