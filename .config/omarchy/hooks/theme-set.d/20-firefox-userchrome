#!/bin/bash
#
# Generates userChrome.css for Firefox, LibreWolf, and Zen (whichever
# are actually installed) from the current Omarchy colors.toml, and
# makes sure each one actually reads userChrome.css files at all (off
# by default in all three, since they share the same Gecko toolkit).
#
# Caveat, inherent to userChrome.css and not something this hook can
# work around: these browsers only re-read it when a browser window is
# created, not live while running -- open a new window, or restart, to
# see the updated theme after switching Omarchy themes. There's no
# equivalent of Chromium's --refresh-platform-policy here.
set -euo pipefail

COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
[[ -f $COLORS ]] || exit 0

get() {
  local key=$1 default=${2:-}
  local val
  val=$(sed -n "s/^$key = \"//p" "$COLORS" | sed 's/"$//' | head -1)
  if [[ -n $val ]]; then
    echo "$val"
  else
    echo "$default"
  fi
}

bg=$(get bg "#1a1b26")
fg=$(get fg "#a9b1d6")
accent=$(get accent "#7aa2f7")
dark_bg=$(get dark_bg "$bg")
lighter_bg=$(get lighter_bg "$bg")
muted=$(get muted "#565f89")

# --- guaranteed-contrast color mixing ---------------------------------------
# A theme's own lighter_bg is chosen by its author for general UI tone,
# not calibrated to guarantee visible contrast against bg specifically
# for "is this tab selected or not" -- in some palettes the two end up
# close enough in lightness that the selected tab is genuinely hard to
# spot. Mixing toward fg instead is robust across every theme (dark or
# light), since fg/bg always have a large, readability-driven contrast
# gap by construction, unlike lighter_bg or accent, which are decorative
# and can be close to bg in low-saturation palettes.
mix_hex() {
  local c1="${1#\#}" c2="${2#\#}" pct="$3"
  local r1=$((16#${c1:0:2})) g1=$((16#${c1:2:2})) b1=$((16#${c1:4:2}))
  local r2=$((16#${c2:0:2})) g2=$((16#${c2:2:2})) b2=$((16#${c2:4:2}))
  local r=$(((r1 * (100 - pct) + r2 * pct) / 100))
  local g=$(((g1 * (100 - pct) + g2 * pct) / 100))
  local b=$(((b1 * (100 - pct) + b2 * pct) / 100))
  printf '#%02x%02x%02x' "$r" "$g" "$b"
}

# 20% fg mixed into bg: a visibly lighter surface no matter how close
# the theme's own lighter_bg happens to sit next to bg.
tab_selected_bg=$(mix_hex "$bg" "$fg" 20)
# Push the accent line toward fg brightness too, so it reads as a
# distinct highlight even when a theme's accent is fairly desaturated.
tab_line=$(mix_hex "$accent" "$fg" 35)

# --- find a browser's default profile, given candidate base dirs ------------
# Firefox, LibreWolf, and Zen all share Gecko's toolkit/profile code, so
# they all lay out profiles.ini the same way -- only the base directory
# (and, in the case of LibreWolf/Zen, which of several possible base
# directories is actually in use) differs.
find_profile_in_base() {
  local base="$1"
  local ini="$base/profiles.ini"
  [[ -f $ini ]] || return 1

  # Modern (67+): an [InstallXXXX] section's Default= line names the
  # profile actually used by *this* installation. Prefer it over the
  # legacy per-profile Default=1 flag below, which can be stale if
  # multiple profiles exist.
  local rel_path
  rel_path=$(awk -F= '/^\[Install/{f=1} f && /^Default=/{print $2; exit}' "$ini")

  if [[ -z $rel_path ]]; then
    rel_path=$(awk -F= '
      /^\[Profile/ { path=""; isdefault=0 }
      /^Path=/     { path=$2 }
      /^Default=1/ { isdefault=1 }
      isdefault && path { print path; exit }
    ' "$ini")
  fi

  [[ -n $rel_path ]] || return 1
  echo "$base/$rel_path"
}

# Tries each candidate base dir in priority order, returns the first
# one that actually resolves to a profile.
find_profile() {
  local base resolved
  for base in "$@"; do
    if resolved=$(find_profile_in_base "$base"); then
      echo "$resolved"
      return 0
    fi
  done
  return 1
}

apply_theme_to_profile() {
  local label="$1" profile_dir="$2"
  local chrome_dir="$profile_dir/chrome"
  mkdir -p "$chrome_dir"

  cat >"$chrome_dir/userChrome.css" <<CSSEOF
/* Generated by ~/.config/omarchy/hooks/theme-set.d/20-firefox-userchrome
   Do not edit by hand -- overwritten on the next theme switch. */
:root {
  --toolbar-bgcolor: $bg !important;
  --toolbar-color: $fg !important;
  --tab-selected-bgcolor: $tab_selected_bg !important;
  --lwt-accent-color: $bg !important;
  --lwt-text-color: $fg !important;
  --lwt-toolbar-field-background-color: $dark_bg !important;
  --lwt-toolbar-field-color: $fg !important;
  --lwt-toolbar-field-border-color: $muted !important;
  --urlbar-box-bgcolor: $dark_bg !important;
  --urlbar-box-text-color: $fg !important;
  --arrowpanel-background: $bg !important;
  --arrowpanel-color: $fg !important;
  --arrowpanel-border-color: $muted !important;
  --tab-line-color: $tab_line !important;
  --focus-outline-color: $tab_line !important;
}

#TabsToolbar, #nav-bar, #titlebar {
  background-color: $bg !important;
}

.tab-background {
  background-color: $bg !important;
}

/* Firefox has used both [selected="true"] and [visuallyselected="true"]
   across versions/forks -- cover both so this doesn't silently stop
   working after an update.

   .tab-background fills its parent tab's full hitbox edge-to-edge
   (position: absolute; inset: 0 in Firefox's own stylesheet), which is
   why a background-color change alone -- or a box-shadow limited to
   just the top/bottom edges -- doesn't read as a distinct shape: there
   was never any visible boundary on the left/right sides at all.

   Overriding *inset* itself (rather than adding margin to the tab, which
   risks fighting Firefox's JS-driven tab-width layout) pulls the
   decorative background away from all four edges of the tab's hitbox
   without changing the hitbox/click target itself. Combined with a full
   border and border-radius, the active tab reads as a distinct floating
   chip -- the same treatment Arc, Chrome, Safari, and Edge all use for
   their active-tab affordance -- rather than depending on background
   contrast alone. */
.tabbrowser-tab[selected="true"] .tab-background,
.tabbrowser-tab[visuallyselected="true"] .tab-background {
  background-color: $tab_selected_bg !important;
  inset: 3px 4px !important;
  border: 1px solid $tab_line !important;
  border-radius: 8px !important;
  box-shadow: inset 0 1px 0 0 $tab_line !important;
}
CSSEOF

  local user_js="$profile_dir/user.js"
  local pref_line='user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
  if [[ ! -f $user_js ]] || ! grep -qF "$pref_line" "$user_js"; then
    echo "$pref_line" >>"$user_js"
  fi

  echo "omarchy-hook firefox-userchrome: [$label] wrote $chrome_dir/userChrome.css"
}

APPLIED_ANY=0

if profile=$(find_profile "$HOME/.mozilla/firefox"); then
  apply_theme_to_profile "Firefox" "$profile"
  APPLIED_ANY=1
fi

if profile=$(find_profile \
  "$HOME/.librewolf" \
  "$HOME/.config/librewolf/librewolf" \
  "$HOME/.var/app/io.gitlab.librewolf-community/.librewolf"); then
  apply_theme_to_profile "LibreWolf" "$profile"
  APPLIED_ANY=1
fi

if profile=$(find_profile \
  "$HOME/.zen" \
  "$HOME/.config/zen" \
  "$HOME/.var/app/app.zen_browser.zen/zen"); then
  apply_theme_to_profile "Zen" "$profile"
  APPLIED_ANY=1
fi

if ((APPLIED_ANY == 0)); then
  echo "omarchy-hook firefox-userchrome: no Firefox/LibreWolf/Zen profile found, skipping" >&2
  exit 0
fi

echo "  (new browser windows pick this up immediately; existing windows need a restart)"
