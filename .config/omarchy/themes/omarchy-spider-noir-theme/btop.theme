# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#090909"

# Main text color
theme[main_fg]="#d7d7d7"

# Title color for boxes
theme[title]="#d7d7d7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#808080"

# Background color of selected item in processes box. #d7d7d7 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #222222 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#222222"

# Foreground color of selected item in processes box. Use #d7d7d7 so
# the row text stays readable on the lighter_bg highlight; the previous
# #808080 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#d7d7d7"

# Color of inactive/disabled text
theme[inactive_fg]="#62605a"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #dddddd caps at #ffffff when the foreground is already pure white, so we
# just bind it to #d7d7d7 directly.
theme[graph_text]="#d7d7d7"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #d7d7d7 collapsed to the main fg.
theme[meter_bg]="#222222"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #dadada for a distinct accent instead of #dddddd which capped to white.
theme[proc_misc]="#dadada"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#acacac"
theme[mem_box]="#c3c3c3"
theme[net_box]="#969696"
theme[proc_box]="#808080"

# Box divider line and small boxes line color
theme[div_line]="#62605a"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#c3c3c3"
theme[temp_mid]="#f2f2f2"
theme[temp_end]="#969696"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#dadada"
theme[cpu_mid]="#808080"
theme[cpu_end]="#acacac"

# Mem/Disk free meter
theme[free_start]="#acacac"
theme[free_mid]="#808080"
theme[free_end]="#dadada"

# Mem/Disk cached meter
theme[cached_start]="#808080"
theme[cached_mid]="#dadada"
theme[cached_end]="#acacac"

# Mem/Disk available meter
theme[available_start]="#f2f2f2"
theme[available_mid]="#969696"
theme[available_end]="#969696"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#c3c3c3"
theme[used_mid]="#dadada"
theme[used_end]="#808080"

# Download graph colors
theme[download_start]="#f2f2f2"
theme[download_mid]="#969696"
theme[download_end]="#969696"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#c3c3c3"
theme[upload_mid]="#dadada"
theme[upload_end]="#808080"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#dadada"
theme[process_mid]="#808080"
theme[process_end]="#acacac"
