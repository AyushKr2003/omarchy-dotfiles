#!/usr/bin/env bash
# Switch the Omarchy shell bar between Omacale, Hanko and Omarchy's default.
#
#   omarchy-bar-switch                           pick one in the terminal (gum/fzf);
#                                                `next` when there is no terminal
#   omarchy-bar-switch [omacale|hanko|default]   switch to that bar
#   omarchy-bar-switch pick                      the same picker (SUPER+SHIFT+CTRL+B opens it
#                                                in a floating terminal)
#   omarchy-bar-switch next                      cycle omacale → hanko → default
#   omarchy-bar-switch status                    print the active bar and its extras
#
# Each bar brings its extras and takes them away again when you leave it:
#   omacale  notifications, OSD and lock screen (its handover clones) and its
#            block in shell.toml (Omacale writes it back when it starts)
#   hanko    Kaze 風, the desk (hanko.desk/background/osd/notifications/menu/
#            lock, the theme-set, battery, update and boot hooks, the menu's
#            colours in shell.toml), the brush cursor, Dōgu (btop/Neovim) and
#            Sumi. What was on is remembered and comes back with Hanko; Kaze
#            is turned on the first time.
#   default  Omarchy's own everything.
# Hyprland keybinds and look'n'feel follow `bar.id` in shell.json (see
# bindings.lua and looknfeel.lua), so the switch ends with `hyprctl reload`.
set -euo pipefail

dotfiles="$HOME/omarchy-dotfiles"
plugins="$HOME/.config/omarchy/plugins"
shell_json="$HOME/.config/omarchy/shell.json"
omacale_scripts="$plugins/omacale.bar/scripts"
hanko="$dotfiles/shell/hanko/scripts/hanko"
state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-bar-switch"
hanko_state="$state/hanko"
modes=(omacale hanko default)

declare -A plugin_src=(
  [omacale]="$dotfiles/shell/omacale"
  [hanko]="$dotfiles/shell/hanko"
)
declare -A label=(
  [omacale]="Omacale  · Caelestia-style frame, drawers, its own notifications/OSD/lock"
  [hanko]="Hanko    · ink and paper, with Kaze 風 (the whole desk)"
  [default]="Omarchy  · the stock bar and everything stock"
)

say() { printf '\e[1;34m::\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m!!\e[0m %s\n' "$*" >&2; }
die() { printf '\e[1;31m!!\e[0m %s\n' "$*" >&2; exit 1; }

current() {
  local id
  id="$(jq -r '.bar.id // ""' "$shell_json" 2>/dev/null || true)"
  case $id in
    omacale.bar) echo omacale ;;
    hanko.bar) echo hanko ;;
    *) echo default ;;
  esac
}

next_mode() {
  local cur i
  cur="$(current)"
  for i in "${!modes[@]}"; do
    [[ ${modes[$i]} == "$cur" ]] && { echo "${modes[$(((i + 1) % ${#modes[@]}))]}"; return; }
  done
  echo "${modes[0]}"
}

# The terminal picker: one line per bar, the active one marked.
pick() {
  local cur m lines=() choice
  cur="$(current)"
  for m in "${modes[@]}"; do
    if [[ $m == "$cur" ]]; then lines+=("● ${label[$m]}"); else lines+=("  ${label[$m]}"); fi
  done
  if command -v gum >/dev/null 2>&1; then
    choice="$(printf '%s\n' "${lines[@]}" | gum choose --header "Bar (now: $cur)" --selected "$(printf '%s\n' "${lines[@]}" | grep '^●')")" || exit 0
  elif command -v fzf >/dev/null 2>&1; then
    choice="$(printf '%s\n' "${lines[@]}" | fzf --height 7 --reverse --no-sort --prompt "bar (now: $cur) > ")" || exit 0
  else
    local i=1
    for m in "${lines[@]}"; do printf '%d) %s\n' "$i" "$m"; i=$((i + 1)); done
    read -r -p "bar [1-${#modes[@]}]: " i
    [[ $i =~ ^[1-9]$ && $i -le ${#modes[@]} ]] || exit 0
    choice="${lines[$((i - 1))]}"
  fi
  [[ -n $choice ]] || exit 0
  for m in "${modes[@]}"; do
    [[ $choice == *"${label[$m]}" ]] && { echo "$m"; return; }
  done
  exit 0
}

# The plugin folder must exist before bar.id points at it.
ensure_plugin() {
  local mode="$1" dest="$plugins/$1.bar" src="${plugin_src[$1]}"
  [[ -e $dest ]] && return
  [[ -d $src ]] || die "$mode source not found at $src"
  say "linking $dest → $src"
  ln -s "$src" "$dest"
}

# ── Omacale ─────────────────────────────────────────────────────────────────
# Its lock handover takes any plugin cloned from omarchy.lock as its own, so
# it only ever runs with Hanko's desk (hanko.lock) already gone.
omacale_handovers() {
  local action="$1"
  [[ -d $omacale_scripts ]] || { warn "omacale scripts missing; skipping notification/OSD/lock $action"; return; }
  say "omacale: $action notifications, OSD and lock screen"
  python3 "$omacale_scripts/notif-popups" "$action" --no-restart >/dev/null || warn "notif-popups $action failed"
  python3 "$omacale_scripts/osd-handover" "$action" >/dev/null || warn "osd-handover $action failed"
  python3 "$omacale_scripts/lock-screen" "$action" >/dev/null || warn "lock-screen $action failed"
}

omacale_off() {
  omacale_handovers remove
  if [[ -f $omacale_scripts/shell-toml && $(python3 "$omacale_scripts/shell-toml" status 2>/dev/null) == present ]]; then
    say "omacale: taking its colours out of shell.toml"
    python3 "$omacale_scripts/shell-toml" remove >/dev/null || warn "shell-toml remove failed"
  fi
}

# ── Hanko ───────────────────────────────────────────────────────────────────
hk() { "$hanko" "$@"; }
hk_status() { hk "$1" status 2>/dev/null || echo off; }

# Remembers what was on (desk, cursor, tools) so `hanko_on` can put it back,
# then turns all of it off. Only writes the memory while Hanko is the bar or
# something is still on, so a second pass can't overwrite it with "off".
hanko_off() {
  [[ -x $hanko ]] || { warn "hanko script missing at $hanko"; return; }
  local desk cursor tools sumi
  desk="$(hk_status desk)" cursor="$(hk_status cursor)" tools="$(hk_status tools)" sumi="$(hk_status sumi)"
  if [[ $(current) == hanko || $desk == on || $cursor == on || $tools == on ]]; then
    mkdir -p "$state"
    printf 'desk=%s\ncursor=%s\ntools=%s\n' "$desk" "$cursor" "$tools" >"$hanko_state"
  fi
  [[ $sumi == on ]] && { say "hanko: Sumi off"; hk sumi off >/dev/null || warn "hanko sumi off failed"; }
  [[ $cursor == on ]] && { say "hanko: brush cursor off"; hk cursor off >/dev/null || warn "hanko cursor off failed"; }
  [[ $tools == on ]] && { say "hanko: Dōgu (btop/Neovim) off"; hk tools off >/dev/null || warn "hanko tools off failed"; }
  # `desk status` only reads the flag; leftovers (hooks, clones) count too.
  local id leftover=0
  for id in hanko.desk hanko.background hanko.osd hanko.notifications hanko.menu hanko.lock; do
    [[ -d $plugins/$id ]] && leftover=1
  done
  ls "$HOME"/.config/omarchy/hooks/*/50-hanko-* >/dev/null 2>&1 && leftover=1
  if [[ $desk == on || $leftover == 1 ]]; then
    say "hanko: Kaze 風 off (desk plugins, hooks, menu colours)"
    hk desk off >/dev/null || warn "hanko desk off failed"
  fi
}

hanko_on() {
  [[ -x $hanko ]] || { warn "hanko script missing at $hanko"; return; }
  local desk=on cursor=off tools=off
  # shellcheck source=/dev/null
  [[ -f $hanko_state ]] && source "$hanko_state"
  if [[ $desk == on ]]; then
    say "hanko: Kaze 風 on (this restarts the shell once more)"
    hk desk on >/dev/null || warn "hanko desk on failed; run: hanko desk on"
  fi
  [[ $cursor == on ]] && { say "hanko: brush cursor on"; hk cursor on >/dev/null || warn "hanko cursor on failed"; }
  [[ $tools == on ]] && { say "hanko: Dōgu (btop/Neovim) on"; hk tools on >/dev/null || warn "hanko tools on failed"; }
  return 0
}

# ── Switching ───────────────────────────────────────────────────────────────
set_bar_id() {
  local filter tmp
  if [[ $1 == default ]]; then filter='del(.bar.id)'; else filter=".bar.id = \"$1.bar\""; fi
  tmp="$(mktemp "$shell_json.XXXXXX")"
  jq "$filter" "$shell_json" >"$tmp" && mv -f "$tmp" "$shell_json" || { rm -f "$tmp"; die "could not update $shell_json"; }
}

wait_shell() {
  for _ in {1..40}; do
    omarchy-shell shell ping 2>/dev/null | grep -q ok && return 0
    sleep 0.3
  done
  return 1
}

switch_to() {
  local target="$1" from
  from="$(current)"
  [[ -f $shell_json ]] || die "$shell_json not found"
  [[ $target != default ]] && ensure_plugin "$target"
  say "bar: $from → $target"

  # Already there: put its extras back (refreshing them), take nothing away.
  if [[ $target == "$from" ]]; then
    case $target in
      hanko) omacale_off; hanko_on ;;
      omacale) hanko_off; omacale_handovers install; omarchy restart shell >/dev/null 2>&1 || true ;;
      default) hanko_off; omacale_off; omarchy restart shell >/dev/null 2>&1 || true ;;
    esac
    say "done: $target"
    return
  fi

  # Everything off first, Hanko before Omacale (see omacale_handovers), then
  # the target's own extras on.
  hanko_off
  if [[ $target == omacale ]]; then omacale_handovers install; else omacale_off; fi

  set_bar_id "$target"
  hyprctl reload >/dev/null || warn "hyprctl reload failed"
  omarchy restart shell >/dev/null 2>&1 || warn "shell restart failed; run: omarchy restart shell"
  wait_shell || warn "the shell did not answer yet"

  [[ $target == hanko ]] && hanko_on
  notify-send -a "Bar" "Bar switched" "Now using: $target" 2>/dev/null || true
  say "done: $target"
}

status() {
  local cur
  cur="$(current)"
  echo "$cur"
  [[ -x $hanko ]] && printf '  hanko   desk=%s cursor=%s tools=%s sumi=%s\n' \
    "$(hk_status desk)" "$(hk_status cursor)" "$(hk_status tools)" "$(hk_status sumi)"
  if [[ -d $omacale_scripts ]]; then
    printf '  omacale notifications: %s\n' "$(python3 "$omacale_scripts/notif-popups" status 2>/dev/null | awk '/^clone:/{$1="";print substr($0,2)}')"
    printf '  omacale osd: %s\n' "$(python3 "$omacale_scripts/osd-handover" status 2>/dev/null | awk '/^clone:/{$1="";print substr($0,2)}')"
    printf '  lock clone: %s\n' "$(python3 "$omacale_scripts/lock-screen" status 2>/dev/null | awk '/^clone:/{$1="";print substr($0,2)}')"
  fi
}

arg="${1:-}"
if [[ -z $arg ]]; then
  if [[ -t 0 && -t 1 ]]; then arg="$(pick)"; [[ -n $arg ]] || exit 0; else arg=next; fi
fi

case "$arg" in
  status) status ;;
  next | toggle) switch_to "$(next_mode)" ;;
  pick | menu) m="$(pick)"; if [[ -n $m ]]; then switch_to "$m"; fi ;;
  omacale | hanko | default) switch_to "$arg" ;;
  omarchy) switch_to default ;;
  -h | --help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown mode '$arg' (omacale | hanko | default | next | pick | status)" ;;
esac
