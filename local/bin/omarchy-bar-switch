#!/usr/bin/env bash
# Switch the Omarchy shell bar between Omacale, Hanko, Meander, Atoll and Omarchy's default.
#
#   omarchy-bar-switch                           pick one in the terminal (gum/fzf);
#                                                `next` when there is no terminal
#   omarchy-bar-switch [omacale|hanko|meander|atoll|default]  switch to that bar
#   omarchy-bar-switch pick                      the same picker (SUPER+SHIFT+CTRL+B opens it
#                                                in a floating terminal)
#   omarchy-bar-switch next                      cycle omacale → hanko → meander → atoll → default
#   omarchy-bar-switch status                    print the active bar and its extras
#
# Each bar brings its extras and takes them away again when you leave it:
#   omacale  notifications, OSD and lock screen (its handover clones) and its
#            block in shell.toml (Omacale writes it back when it starts)
#   hanko    Kaze 風, the desk (hanko.desk/background/osd/notifications/menu/
#            lock, the theme-set, battery, update and boot hooks, the menu's
#            colours in shell.toml), the brush cursor, Dōgu (btop/Neovim) and
#            Sumi. What was on is remembered and comes back with Hanko; Kaze
#            is turned on the first time.
#   meander  its own notifications, polkit, lock, OSD, dock and wallpaper:
#            `meander-setup enable` hands Omarchy's over in shell.json and
#            `meander-setup disable` gives back exactly what it took.
#   atoll    its notifications, OSD and dock: Omarchy's are switched off and
#            Omarchy's background is switched on (Atoll draws none); the
#            lock screen gets Atoll's look (atoll.lock, a clone of
#            omarchy.lock that keeps Omarchy's PAM/idle/suspend service);
#            the ones it switched off are remembered and switched back on
#            when you leave. Its `atoll` command is linked on first switch.
#   default  Omarchy's own everything.
# Hyprland keybinds and look'n'feel follow `bar.id` in shell.json (see
# bindings.lua and looknfeel.lua), so the switch ends with `hyprctl reload`.
set -euo pipefail

dotfiles="$HOME/omarchy-dotfiles"
plugins="$HOME/.config/omarchy/plugins"
shell_json="$HOME/.config/omarchy/shell.json"
omacale_scripts="$plugins/omacale.bar/scripts"
hanko="$dotfiles/shell/hanko/scripts/hanko"
state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-bar-switch"
hanko_state="$state/hanko"
modes=(omacale hanko meander atoll default)

declare -A plugin_src=(
  [omacale]="$dotfiles/shell/omacale"
  [hanko]="$dotfiles/shell/hanko"
  [meander]="$dotfiles/shell/meander"
  [atoll]="$dotfiles/shell/Atoll"
)
meander_setup="$dotfiles/shell/meander/bin/meander-setup"
declare -A name=([omacale]=Omacale [hanko]=Hanko [meander]=Meander [atoll]=Atoll [default]=Omarchy)
declare -A desc=(
  [omacale]="Caelestia-style frame, drawers, its own notifications/OSD/lock"
  [hanko]="ink and paper, with Kaze 風 (the whole desk)"
  [meander]="Serpantinum-style desk: morphing popouts, dock, widgets, its own lock"
  [atoll]="Ambxst-style notch: launcher, dashboard, dock, its own notifications/OSD"
  [default]="the stock bar and everything stock"
)

say() { printf '\e[1;34m::\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m!!\e[0m %s\n' "$*" >&2; }
die() { printf '\e[1;31m!!\e[0m %s\n' "$*" >&2; exit 1; }

current() {
  local id
  id="$(jq -r '.bar.id // ""' "$shell_json" 2>/dev/null || true)"
  case $id in
    omacale.bar) echo omacale ;;
    hanko.bar) echo hanko ;;
    meander.bar) echo meander ;;
    atoll.bar) echo atoll ;;
    *) echo default ;;
  esac
}

next_mode() {
  local cur i
  cur="$(current)"
  for i in "${!modes[@]}"; do
    [[ ${modes[$i]} == "$cur" ]] && { echo "${modes[$(((i + 1) % ${#modes[@]}))]}"; return; }
  done
  echo "${modes[0]}"
}

# The terminal picker: one row per bar ("● Name  description"), the active one
# marked and preselected. Prints the chosen mode; returns 130 when cancelled so
# the floating terminal closes instead of showing "Done!".
# Rows start with a mark, never a space: gum 2 trims leading whitespace off
# its input, which misaligned the first row.
pick() {
  local cur m row rows=() selected="" choice i
  cur="$(current)"
  for m in "${modes[@]}"; do
    row="$(printf '%s %-8s %s' "$([[ $m == "$cur" ]] && echo ● || echo ○)" "${name[$m]}" "${desc[$m]}")"
    [[ $m == "$cur" ]] && selected="$row"
    rows+=("$row|$m")
  done

  if command -v gum >/dev/null 2>&1; then
    choice="$(printf '%s\n' "${rows[@]}" | gum choose --label-delimiter='|' \
      --header "Switch bar  ·  now: ${name[$cur]}" --selected "$selected")" || return 130
  elif command -v fzf >/dev/null 2>&1; then
    choice="$(printf '%s\n' "${rows[@]}" | fzf --height 8 --reverse --no-sort --no-info \
      --delimiter '|' --with-nth 1 --header "now: ${name[$cur]}" --prompt 'bar > ')" || return 130
    choice="${choice##*|}"
  else
    i=1
    for row in "${rows[@]}"; do printf '%d) %s\n' "$i" "${row%|*}"; i=$((i + 1)); done
    read -r -p "bar [1-${#modes[@]}]: " i || return 130
    [[ $i =~ ^[1-9]$ && $i -le ${#modes[@]} ]] || return 130
    choice="${modes[$((i - 1))]}"
  fi
  [[ -n ${name[$choice]:-} ]] || return 130

  # Picking the bar you're on restarts the shell to refresh its extras; ask.
  if [[ $choice == "$cur" ]] && command -v gum >/dev/null 2>&1; then
    gum confirm "Already on ${name[$cur]}. Refresh it (restarts the shell)?" || return 130
  fi
  echo "$choice"
}

# The plugin folder must exist before bar.id points at it.
ensure_plugin() {
  local mode="$1" dest="$plugins/$1.bar" src="${plugin_src[$1]}"
  [[ -e $dest ]] && return
  [[ -d $src ]] || die "$mode source not found at $src"
  say "linking $dest → $src"
  ln -s "$src" "$dest"
}

# ── Omacale ─────────────────────────────────────────────────────────────────
# Its lock handover takes any plugin cloned from omarchy.lock as its own, so
# it only ever runs with Hanko's desk (hanko.lock) already gone.
omacale_handovers() {
  local action="$1"
  [[ -d $omacale_scripts ]] || { warn "omacale scripts missing; skipping notification/OSD/lock $action"; return; }
  say "omacale: $action notifications, OSD and lock screen"
  python3 "$omacale_scripts/notif-popups" "$action" --no-restart >/dev/null || warn "notif-popups $action failed"
  python3 "$omacale_scripts/osd-handover" "$action" >/dev/null || warn "osd-handover $action failed"
  # Its remove takes any clone of omarchy.lock, Atoll's (atoll.lock) too;
  # that one is Atoll's to give back.
  if [[ $action == remove && -d $plugins/atoll.lock ]]; then
    :
  else
    python3 "$omacale_scripts/lock-screen" "$action" >/dev/null || warn "lock-screen $action failed"
  fi
}

omacale_off() {
  omacale_handovers remove
  if [[ -f $omacale_scripts/shell-toml && $(python3 "$omacale_scripts/shell-toml" status 2>/dev/null) == present ]]; then
    say "omacale: taking its colours out of shell.toml"
    python3 "$omacale_scripts/shell-toml" remove >/dev/null || warn "shell-toml remove failed"
  fi
}

# ── Hanko ───────────────────────────────────────────────────────────────────
hk() { "$hanko" "$@"; }
hk_status() { hk "$1" status 2>/dev/null || echo off; }

# Remembers what was on (desk, cursor, tools) so `hanko_on` can put it back,
# then turns all of it off. Only writes the memory while Hanko is the bar or
# something is still on, so a second pass can't overwrite it with "off".
hanko_off() {
  [[ -x $hanko ]] || { warn "hanko script missing at $hanko"; return; }
  local desk cursor tools sumi
  desk="$(hk_status desk)" cursor="$(hk_status cursor)" tools="$(hk_status tools)" sumi="$(hk_status sumi)"
  if [[ $(current) == hanko || $desk == on || $cursor == on || $tools == on ]]; then
    mkdir -p "$state"
    printf 'desk=%s\ncursor=%s\ntools=%s\n' "$desk" "$cursor" "$tools" >"$hanko_state"
  fi
  [[ $sumi == on ]] && { say "hanko: Sumi off"; hk sumi off >/dev/null || warn "hanko sumi off failed"; }
  [[ $cursor == on ]] && { say "hanko: brush cursor off"; hk cursor off >/dev/null || warn "hanko cursor off failed"; }
  [[ $tools == on ]] && { say "hanko: Dōgu (btop/Neovim) off"; hk tools off >/dev/null || warn "hanko tools off failed"; }
  # `desk status` only reads the flag; leftovers (hooks, clones) count too.
  local id leftover=0
  for id in hanko.desk hanko.background hanko.osd hanko.notifications hanko.menu hanko.lock; do
    [[ -d $plugins/$id ]] && leftover=1
  done
  ls "$HOME"/.config/omarchy/hooks/*/50-hanko-* >/dev/null 2>&1 && leftover=1
  if [[ $desk == on || $leftover == 1 ]]; then
    say "hanko: Kaze 風 off (desk plugins, hooks, menu colours)"
    hk desk off >/dev/null || warn "hanko desk off failed"
  fi
}

hanko_on() {
  [[ -x $hanko ]] || { warn "hanko script missing at $hanko"; return; }
  local desk=on cursor=off tools=off
  # shellcheck source=/dev/null
  [[ -f $hanko_state ]] && source "$hanko_state"
  if [[ $desk == on ]]; then
    say "hanko: Kaze 風 on (this restarts the shell once more)"
    hk desk on >/dev/null || warn "hanko desk on failed; run: hanko desk on"
  fi
  [[ $cursor == on ]] && { say "hanko: brush cursor on"; hk cursor on >/dev/null || warn "hanko cursor on failed"; }
  [[ $tools == on ]] && { say "hanko: Dōgu (btop/Neovim) on"; hk tools on >/dev/null || warn "hanko tools on failed"; }
  return 0
}

# ── Meander ─────────────────────────────────────────────────────────────────
# Meander's installer owns its handover: enable records what it turns off in
# shell.json, disable puts exactly that back. Its commands (meander,
# meander-core, ...) must be on PATH, so a first switch installs them, linked
# to the checkout like the other bars.
meander_on() {
  [[ -x $meander_setup ]] || { warn "meander-setup missing at $meander_setup"; return 1; }
  if ! command -v meander-core >/dev/null 2>&1; then
    say "meander: linking its commands (first switch)"
    "$meander_setup" install --dev --no-deps --no-enable >/dev/null || warn "meander install failed"
  fi
  say "meander: taking over notifications, polkit, lock, OSD, dock and wallpaper"
  "$meander_setup" enable >/dev/null || warn "meander enable failed"
}

meander_off() {
  [[ -x $meander_setup ]] || return 0
  # Only when Meander still holds something (or is the bar), so other
  # switches leave its record alone.
  if [[ $(current) == meander || $(jq -r '(.addedDisabled // []) | length' "${XDG_STATE_HOME:-$HOME/.local/state}/meander/install.json" 2>/dev/null || echo 0) != 0 ]]; then
    say "meander: giving Omarchy its engines back"
    "$meander_setup" disable >/dev/null || warn "meander disable failed"
  fi
}

# ── Atoll ───────────────────────────────────────────────────────────────────
# Atoll draws notifications, OSD and dock itself, so Omarchy's are switched
# off while it is the bar. Only the ones that were still on get recorded, and
# only those are switched back on when you leave.
atoll_state="$state/atoll-disabled"
atoll_takes=(omarchy.notifications omarchy.osd omarchy.dock)
# Atoll leaves the wallpaper to Omarchy: omarchy.background is switched on
# while it is the bar (and off again on leaving, if it was off before).
atoll_bg_state="$state/atoll-enabled-background"
# Atoll's lock screen: a clone of omarchy.lock (atoll.lock) that keeps
# Omarchy's lock service and swaps in Atoll's view.
atoll_lock="${plugin_src[atoll]}/scripts/lock-handover"

# edit_shell_json FILTER ID... : the IDs reach the filter as $ids.
# Never replaces shell.json with an empty result.
edit_shell_json() {
  local filter="$1" tmp ids
  shift
  ids="$(printf '%s\n' "$@" | jq -Rn '[inputs | select(length > 0)]')"
  tmp="$(mktemp "$shell_json.XXXXXX")"
  if jq --argjson ids "$ids" "$filter" "$shell_json" >"$tmp" && [[ -s $tmp ]]; then
    mv -f "$tmp" "$shell_json"
  else
    rm -f "$tmp"; warn "could not update $shell_json"
  fi
}

atoll_on() {
  local id taken=()
  if [[ ! -e $HOME/.local/bin/atoll ]]; then
    say "atoll: linking its command (first switch)"
    mkdir -p "$HOME/.local/bin"
    ln -s "${plugin_src[atoll]}/bin/atoll" "$HOME/.local/bin/atoll"
  fi
  for id in "${atoll_takes[@]}"; do
    jq -e --arg id "$id" '(.disabledPlugins // []) | index($id)' "$shell_json" >/dev/null 2>&1 || taken+=("$id")
  done
  mkdir -p "$state"
  # Keep what an earlier switch recorded (a refresh finds them already off).
  { [[ -f $atoll_state ]] && cat "$atoll_state"; ((${#taken[@]})) && printf '%s\n' "${taken[@]}"; true; } | sort -u >"$atoll_state.tmp"
  mv -f "$atoll_state.tmp" "$atoll_state"
  if jq -e '(.disabledPlugins // []) | index("omarchy.background")' "$shell_json" >/dev/null 2>&1; then
    say "atoll: switching on Omarchy's background"
    edit_shell_json '.disabledPlugins = ((.disabledPlugins // []) - $ids)' omarchy.background
    touch "$atoll_bg_state"
  fi
  if ((${#taken[@]})); then
    say "atoll: taking over ${taken[*]}"
    edit_shell_json '.disabledPlugins = ((.disabledPlugins // []) + $ids | unique)' "${taken[@]}"
  fi
  if [[ -x $atoll_lock ]]; then
    say "atoll: its lock screen (on Omarchy's lock service)"
    "$atoll_lock" install >/dev/null || warn "atoll lock screen failed; Omarchy's stays"
  fi
}

atoll_off() {
  if [[ -f $atoll_bg_state ]]; then
    say "atoll: Omarchy's background off again (as before Atoll)"
    edit_shell_json '.disabledPlugins = ((.disabledPlugins // []) + $ids | unique)' omarchy.background
    rm -f "$atoll_bg_state"
  fi
  if [[ -x $atoll_lock && $("$atoll_lock" status) == installed ]]; then
    say "atoll: giving the lock screen back to Omarchy"
    "$atoll_lock" remove >/dev/null || warn "atoll lock-handover remove failed"
  fi
  [[ -s $atoll_state ]] || return 0
  local ids
  mapfile -t ids <"$atoll_state"
  say "atoll: giving Omarchy back ${ids[*]}"
  edit_shell_json '.disabledPlugins = ((.disabledPlugins // []) - $ids)' "${ids[@]}"
  rm -f "$atoll_state"
}

# ── Switching ───────────────────────────────────────────────────────────────
set_bar_id() {
  local filter tmp
  if [[ $1 == default ]]; then filter='del(.bar.id)'; else filter=".bar.id = \"$1.bar\""; fi
  tmp="$(mktemp "$shell_json.XXXXXX")"
  if jq "$filter" "$shell_json" >"$tmp" && [[ -s $tmp ]]; then mv -f "$tmp" "$shell_json"; else rm -f "$tmp"; die "could not update $shell_json"; fi
}

wait_shell() {
  for _ in {1..40}; do
    omarchy-shell shell ping 2>/dev/null | grep -q ok && return 0
    sleep 0.3
  done
  return 1
}

switch_to() {
  local target="$1" from
  from="$(current)"
  [[ -f $shell_json ]] || die "$shell_json not found"
  [[ $target != default ]] && ensure_plugin "$target"
  say "bar: $from → $target"

  # Already there: put its extras back (refreshing them), take nothing away.
  if [[ $target == "$from" ]]; then
    case $target in
      hanko) omacale_off; atoll_off; hanko_on ;;
      omacale) hanko_off; meander_off; atoll_off; omacale_handovers install; omarchy restart shell >/dev/null 2>&1 || true ;;
      meander) hanko_off; omacale_off; atoll_off; meander_on; omarchy restart shell >/dev/null 2>&1 || true ;;
      atoll) hanko_off; omacale_off; meander_off; atoll_on; omarchy restart shell >/dev/null 2>&1 || true ;;
      default) hanko_off; omacale_off; meander_off; atoll_off; omarchy restart shell >/dev/null 2>&1 || true ;;
    esac
    say "done: $target"
    return
  fi

  # Everything off first, Hanko before Omacale (see omacale_handovers), and
  # Meander's handover given back, then the target's own extras on.
  hanko_off
  meander_off
  atoll_off
  if [[ $target == omacale ]]; then omacale_handovers install; else omacale_off; fi

  # Meander sets bar.id itself (and records the bar it replaced).
  [[ $target == atoll ]] && atoll_on
  if [[ $target == meander ]]; then meander_on; else set_bar_id "$target"; fi
  hyprctl reload >/dev/null || warn "hyprctl reload failed"
  omarchy restart shell >/dev/null 2>&1 || warn "shell restart failed; run: omarchy restart shell"
  wait_shell || warn "the shell did not answer yet"

  [[ $target == hanko ]] && hanko_on
  notify-send -a "Bar" "Bar switched" "Now using: $target" 2>/dev/null || true
  say "done: $target"
}

status() {
  local cur
  cur="$(current)"
  echo "$cur"
  [[ -x $hanko ]] && printf '  hanko   desk=%s cursor=%s tools=%s sumi=%s\n' \
    "$(hk_status desk)" "$(hk_status cursor)" "$(hk_status tools)" "$(hk_status sumi)"
  [[ -s $atoll_state ]] && printf '  atoll took over: %s\n' "$(paste -sd, "$atoll_state" | sed 's/,/, /g')"
  [[ -x $meander_setup ]] && printf '  meander handed over: %s\n' \
    "$(jq -r '(.addedDisabled // []) | if length == 0 then "nothing" else join(", ") end' "${XDG_STATE_HOME:-$HOME/.local/state}/meander/install.json" 2>/dev/null || echo nothing)"
  if [[ -d $omacale_scripts ]]; then
    printf '  omacale notifications: %s\n' "$(python3 "$omacale_scripts/notif-popups" status 2>/dev/null | awk '/^clone:/{$1="";print substr($0,2)}')"
    printf '  omacale osd: %s\n' "$(python3 "$omacale_scripts/osd-handover" status 2>/dev/null | awk '/^clone:/{$1="";print substr($0,2)}')"
    printf '  lock clone: %s\n' "$(python3 "$omacale_scripts/lock-screen" status 2>/dev/null | awk '/^clone:/{$1="";print substr($0,2)}')"
  fi
}

arg="${1:-}"
if [[ -z $arg ]]; then
  if [[ -t 0 && -t 1 ]]; then arg=pick; else arg=next; fi
fi

case "$arg" in
  status) status ;;
  next | toggle) switch_to "$(next_mode)" ;;
  pick | menu) m="$(pick)" || exit 130; switch_to "$m" ;;
  omacale | hanko | meander | atoll | default) switch_to "$arg" ;;
  omarchy) switch_to default ;;
  -h | --help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown mode '$arg' (omacale | hanko | meander | atoll | default | next | pick | status)" ;;
esac
