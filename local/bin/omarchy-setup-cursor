#!/usr/bin/env bash
# omarchy:summary=Configure system-wide cursor theme and size for GTK, Qt, Electron, Hyprland, and X11/XWayland
# omarchy:args=<theme-name> [size]

set -euo pipefail

THEME="${1:-}"
SIZE="${2:-28}"

if [[ -z "$THEME" ]]; then
  echo "Usage: omarchy-setup-cursor <theme-name> [size]"
  echo ""
  echo "Available installed cursor themes:"
  find /usr/share/icons ~/.icons ~/.local/share/icons -maxdepth 2 -type f \( -name "cursor.theme" -o -name "index.theme" \) 2>/dev/null | while read -r file; do
    dirname "$file" | xargs basename
  done | sort -u | sed 's/^/  - /'
  exit 1
fi

AUTOSTART_LUA="$HOME/.config/hypr/autostart.lua"
if [[ ! -f "$AUTOSTART_LUA" ]]; then
  AUTOSTART_LUA="$HOME/.config/hypr/autostart.lua"
fi

echo "Setting cursor theme to '$THEME' (size: $SIZE)..."

# 1. Update GNOME GSettings
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface cursor-theme "$THEME" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface cursor-size "$SIZE" 2>/dev/null || true
  echo "✓ GTK GSettings updated"
fi

# 2. Update GTK 3 & GTK 4 settings.ini
mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"

for gtk_dir in "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"; do
  ini="$gtk_dir/settings.ini"
  if [[ -f "$ini" ]]; then
    sed -i '/^gtk-cursor-theme-name=/d' "$ini"
    sed -i '/^gtk-cursor-theme-size=/d' "$ini"
    if ! grep -q '\[Settings\]' "$ini"; then
      echo '[Settings]' >> "$ini"
    fi
    echo "gtk-cursor-theme-name=$THEME" >> "$ini"
    echo "gtk-cursor-theme-size=$SIZE" >> "$ini"
  else
    cat << EOF > "$ini"
[Settings]
gtk-cursor-theme-name=$THEME
gtk-cursor-theme-size=$SIZE
EOF
  fi
done
echo "✓ GTK 3.0 and GTK 4.0 settings.ini updated"

# 3. Update XDG ~/.icons/default/index.theme
mkdir -p "$HOME/.icons/default"
cat << EOF > "$HOME/.icons/default/index.theme"
[Icon Theme]
Name=Default
Comment=Default Cursor Theme
Inherits=$THEME
EOF
echo "✓ ~/.icons/default/index.theme updated"

# 4. Update ~/.Xresources
cat << EOF > "$HOME/.Xresources"
Xcursor.theme: $THEME
Xcursor.size: $SIZE
EOF
if command -v xrdb >/dev/null 2>&1; then
  xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
fi
echo "✓ ~/.Xresources updated"

# 5. Update config/hypr/autostart.lua cleanly
if [[ -f "$AUTOSTART_LUA" ]]; then
  # Clean up any old leftover un-marked comments or lines if markers not present yet
  if ! grep -q '\-\- BEGIN CURSOR CONFIG' "$AUTOSTART_LUA" 2>/dev/null && ! grep -q -- '-- BEGIN CURSOR CONFIG' "$AUTOSTART_LUA"; then
    sed -i '/-- System-wide cursor theme/d' "$AUTOSTART_LUA"
    sed -i '/XCURSOR_THEME/d' "$AUTOSTART_LUA"
    sed -i '/XCURSOR_SIZE/d' "$AUTOSTART_LUA"
    sed -i '/HYPRCURSOR_THEME/d' "$AUTOSTART_LUA"
    sed -i '/HYPRCURSOR_SIZE/d' "$AUTOSTART_LUA"
    sed -i '/hyprctl setcursor/d' "$AUTOSTART_LUA"
    sed -i '/gsettings set org.gnome.desktop.interface cursor-theme/d' "$AUTOSTART_LUA"
    sed -i '/gsettings set org.gnome.desktop.interface cursor-size/d' "$AUTOSTART_LUA"
    sed -i '/dbus-update-activation-environment/d' "$AUTOSTART_LUA"
  fi

  python3 - "$AUTOSTART_LUA" "$THEME" "$SIZE" << 'EOF'
import sys, re

lua_path, theme, size = sys.argv[1], sys.argv[2], sys.argv[3]
with open(lua_path, 'r') as f:
    content = f.read()

new_block = f"""-- BEGIN CURSOR CONFIG
hl.env("XCURSOR_THEME", "{theme}")
hl.env("XCURSOR_SIZE", "{size}")
hl.env("HYPRCURSOR_THEME", "{theme}")
hl.env("HYPRCURSOR_SIZE", "{size}")

o.launch_on_start("hyprctl setcursor {theme} {size}")
o.launch_on_start("gsettings set org.gnome.desktop.interface cursor-theme '{theme}'")
o.launch_on_start("gsettings set org.gnome.desktop.interface cursor-size {size}")
o.launch_on_start("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_THEME HYPRCURSOR_SIZE")
-- END CURSOR CONFIG"""

pattern = r'-- BEGIN CURSOR CONFIG.*?\-\- END CURSOR CONFIG'
if re.search(pattern, content, re.DOTALL):
    content = re.sub(pattern, new_block, content, flags=re.DOTALL)
else:
    # Clean up trailing blank lines before appending
    lines = content.rstrip().split('\n')
    content = '\n'.join(lines) + "\n\n" + new_block + "\n"

with open(lua_path, 'w') as f:
    f.write(content)
EOF
  echo "✓ $AUTOSTART_LUA updated"
fi

# 6. Apply live Hyprland & DBus activation environment
if command -v hyprctl >/dev/null 2>&1; then
  hyprctl setcursor "$THEME" "$SIZE" 2>/dev/null || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_THEME HYPRCURSOR_SIZE 2>/dev/null || true
fi

echo ""
echo "Successfully configured '$THEME' (size $SIZE) system-wide!"
