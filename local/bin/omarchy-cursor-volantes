#!/usr/bin/env python3

# omarchy:summary=Rebuild the Volantes-Omarchy cursor in the theme accent
# omarchy:args=[--force] [--full] [#hex]

"""Recolour the Volantes pointer to the current Omarchy theme accent.

The cursors are Volantes by varlesh (GPL-2.0), built from
github.com/varlesh/volantes-cursors. The dark variant draws every cursor from
three colours, which this swaps for the accent:

    #232627  body     -> dark container in the accent hue
    #efefef  outline  -> the accent
    #00aea9  spinner  -> deeper shade of the accent

The theme-set hook calls this on every theme change. It only acts when
Volantes-Omarchy is the selected cursor (the gsettings cursor-theme that
hypr/autostart.lua sets), so other cursors cost nothing.

Same shape as omarchy-cursor-material: the Hyprland pointer (hyprcursor, SVG)
rebuilds fast and applies at once; the X11 bitmaps for XWayland/GTK rebuild in
a detached background pass. --full builds both synchronously (first install).
--force builds even when another cursor is selected.

Upstream's build.sh needs Inkscape; this renders with rsvg-convert instead.
"""

import colorsys
import fcntl
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
import zipfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

THEME = "Volantes-Omarchy"
VARIANT = "volantes_cursors"  # dark base: accent outline on a dark body
HOME = Path.home()
SRC = Path(os.environ.get("OMARCHY_CURSOR_VOLANTES_SRC",
                          HOME / ".local/share/omarchy-cursor-volantes/volantes"))
INSTALL = HOME / ".local/share/icons"
COLORS = HOME / ".local/state/omarchy/current/theme/colors.toml"
LOCK = HOME / ".cache/omarchy-cursor-volantes.lock"
INDEX = ("[Icon Theme]\nName=Volantes Cursors Omarchy\n"
         "Comment=Volantes by varlesh, Omarchy theme accent\nInherits=Adwaita\n")
MANIFEST = ("name = Volantes-Omarchy\ndescription = Volantes cursors in the Omarchy accent\n"
            "version = 0.1\ncursors_directory = hyprcursors\n")

BODY, OUTLINE, SPINNER = "#232627", "#efefef", "#00aea9"


def gsetting(key, default):
    try:
        out = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", key],
                             capture_output=True, text=True, check=True).stdout
        return out.strip().strip("'") or default
    except Exception:
        return default


def active_theme():
    return gsetting("cursor-theme", "")


def cursor_size():
    try:
        return int(gsetting("cursor-size", os.environ.get("XCURSOR_SIZE", "24")))
    except ValueError:
        return 24


def hexval(h):
    h = str(h).strip().lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    if len(h) != 6:
        return None
    try:
        return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return None


def tohex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c))) for c in rgb)


def relit(rgb, lightness, sat_cap):
    r, g, b = (c / 255 for c in rgb)
    hh, _, ss = colorsys.rgb_to_hls(r, g, b)
    return tohex(tuple(c * 255 for c in colorsys.hls_to_rgb(hh, lightness, min(ss, sat_cap))))


def accent():
    for a in sys.argv[1:]:
        if not a.startswith("-") and hexval(a):
            return tohex(hexval(a))
    try:
        p = tomllib.loads(COLORS.read_text()).get("accent")
    except Exception:
        p = None
    return tohex(hexval(p)) if p and hexval(p) else "#e2342a"


def colors_from(acc):
    rgb = hexval(acc)
    return {BODY: relit(rgb, 0.16, 0.35), OUTLINE: acc, SPINNER: relit(rgb, 0.42, 0.9)}


def recolor_dir(colors, dst):
    """Copy the variant's SVGs into dst with the palette swapped."""
    src = SRC / "src" / VARIANT
    if not (src / "default.svg").is_file():
        sys.exit(f"volantes source missing at {SRC} (run install.sh)")
    pat = re.compile("|".join(re.escape(k) for k in colors), re.IGNORECASE)
    dst.mkdir(parents=True, exist_ok=True)
    for svg in src.glob("*.svg"):
        text = pat.sub(lambda m: colors[m.group(0).lower()], svg.read_text())
        (dst / svg.name).write_text(text)


def read_configs():
    """{shape: [(size, hotx, hoty, png, delay)]} from src/config/*.cursor."""
    shapes = {}
    for cfg in sorted((SRC / "src/config").glob("*.cursor")):
        rows = []
        for line in cfg.read_text().split("\n"):
            f = line.split()
            if len(f) >= 4:
                rows.append((int(f[0]), int(f[1]), int(f[2]), f[3],
                             int(f[4]) if len(f) > 4 else 0))
        shapes[cfg.stem] = rows
    return shapes


def read_aliases(shapes):
    """{alias: shape}, following alias chains down to a built shape."""
    raw = {}
    for line in (SRC / "src/cursorList").read_text().split("\n"):
        f = line.split()
        if len(f) == 2:
            raw[f[0]] = f[1]
    out = {}
    for name in raw:
        t, seen = raw[name], {name}
        while t not in shapes and t in raw and t not in seen:
            seen.add(t)
            t = raw[t]
        if t in shapes and name not in shapes:
            out[name] = t
    return out


def png_source(png):
    """default_24_48.png -> (default_24.svg, 48); default_32.png -> (default.svg, 32)."""
    stem, size = png[:-4].rsplit("_", 1)
    return stem + ".svg", int(size)


def build_hypr(colors, out):
    shapes = read_configs()
    aliases = read_aliases(shapes)
    overrides = {}
    for a, s in aliases.items():
        overrides.setdefault(s, []).append(a)
    with tempfile.TemporaryDirectory(prefix="omarchy-cursor-") as tmp:
        svgs = Path(tmp)
        recolor_dir(colors, svgs)
        hc = out / "hyprcursors"
        hc.mkdir(parents=True)
        for shape, rows in shapes.items():
            # The 32px rows use the full-detail SVG; hotspots normalise to it.
            big = [r for r in rows if r[0] == 32] or rows
            size = big[0][0]
            lines = ["resize_algorithm = bilinear",
                     f"hotspot_x = {big[0][1] / size:.3f}",
                     f"hotspot_y = {big[0][2] / size:.3f}", ""]
            lines += [f"define_override = {a}" for a in sorted(overrides.get(shape, []))]
            lines.append("")
            files = []
            for _, _, _, png, delay in big:
                svg, _ = png_source(png)
                files.append(svg)
                lines.append(f"define_size = 0, {svg}" + (f", {delay}" if delay else ""))
            with zipfile.ZipFile(hc / f"{shape}.hlc", "w", zipfile.ZIP_DEFLATED) as z:
                z.writestr("meta.hl", "\n".join(lines) + "\n")
                for svg in dict.fromkeys(files):
                    z.write(svgs / svg, svg)
        (out / "manifest.hl").write_text(MANIFEST)


def build_x11(colors, out):
    shapes = read_configs()
    aliases = read_aliases(shapes)
    with tempfile.TemporaryDirectory(prefix="omarchy-cursor-") as tmp:
        tmp = Path(tmp)
        svgs, pngs = tmp / "svg", tmp / "png"
        recolor_dir(colors, svgs)
        pngs.mkdir()
        jobs = {r[3] for rows in shapes.values() for r in rows}

        def render(png):
            svg, size = png_source(png)
            subprocess.run(["rsvg-convert", "-w", str(size), "-h", str(size),
                            "-o", str(pngs / png), str(svgs / svg)], check=True)

        with ThreadPoolExecutor(os.cpu_count() or 4) as ex:
            list(ex.map(render, jobs))
        cur = out / "cursors"
        cur.mkdir(parents=True)
        for shape in shapes:
            subprocess.run(["xcursorgen", "-p", str(pngs),
                            str(SRC / "src/config" / f"{shape}.cursor"), str(cur / shape)],
                           check=True, stdout=subprocess.DEVNULL)
        for a, s in aliases.items():
            (cur / a).symlink_to(s)


def install_parts(staged, parts):
    """Replace only the named parts, so a hypr pass keeps the X11 cursors/."""
    final = INSTALL / THEME
    final.mkdir(parents=True, exist_ok=True)
    (final / "index.theme").write_text(INDEX)
    for name in parts:
        src, dst = staged / name, final / name
        if not src.exists():
            continue
        if dst.is_dir():
            shutil.rmtree(dst, ignore_errors=True)
        elif dst.exists():
            dst.unlink()
        shutil.move(str(src), str(dst))


def build(fn, parts, colors):
    with tempfile.TemporaryDirectory(prefix="omarchy-cursor-") as tmp:
        fn(colors, Path(tmp))
        install_parts(Path(tmp), parts)


def apply_live():
    subprocess.run(["hyprctl", "setcursor", THEME, str(cursor_size())],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def x11_locked(fn):
    """Skip if an X11 build already runs."""
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCK, "w") as fh:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return
        fn()


def main():
    args = sys.argv[1:]
    acc = accent()
    colors = colors_from(acc)

    if "--x11only" in args:
        x11_locked(lambda: build(build_x11, ["cursors"], colors))
        return

    live = active_theme() == THEME
    if not live and "--force" not in args:
        return

    build(build_hypr, ["hyprcursors", "manifest.hl"], colors)
    if live:
        apply_live()
    if "--full" in args:
        x11_locked(lambda: build(build_x11, ["cursors"], colors))
        if live:
            apply_live()
    else:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--x11only", acc],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
