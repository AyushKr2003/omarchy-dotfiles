#!/usr/bin/env bash

# omarchy:summary=Colour GTK 3 and GTK 4 / libadwaita apps from the Omarchy theme
# omarchy:args=[--force] [--off]

# Builds a GTK palette from the current theme's colors.toml and loads it into
# every GTK app:
#
#   GTK 4 / libadwaita  ~/.config/gtk-4.0/omarchy-theme.css, libadwaita's CSS
#                       variables on :root (libadwaita 1.6+). --accent-color
#                       and the other standalone colours are left out on purpose:
#                       libadwaita derives them from the -bg colours in Oklab so
#                       they stay readable in light and dark.
#   GTK 3               ~/.config/gtk-3.0/omarchy-theme.css, the same palette as
#                       named colours for adw-gtk3 (libadwaita's look and colour
#                       names for GTK 3), plus the older theme_* names for when
#                       the stock Adwaita theme is in use.
#
# Each gtk.css only gets an @import of that file between marker comments, at
# the top, so hand-written rules below it still win and Omarchy's Glassy block
# (omarchy-theme-set-glass) is left alone.
#
# Foregrounds on accent and status colours are black or white, whichever
# contrasts more (WCAG luminance). Surfaces are mixed from the theme's
# background, foreground and dark_background with GTK's own colour functions,
# following libadwaita's structure: in dark themes popovers and dialogs sit a
# little lighter than the window, in light themes views and cards a little
# brighter, with libadwaita's shade opacities for each mode.
#
# omarchy-theme-set-gnome resets gtk-theme to Adwaita(-dark) just before the
# theme-set hooks run, so this sets adw-gtk3(-dark) again when it is installed.
#
# The theme-set hook calls this on every theme change. It only acts while
# ~/.config/omarchy/gtk-theme exists (install.sh creates it); --force builds
# anyway, --off removes it, the import blocks and the generated files.
#
# GTK reads CSS when an app starts, so open apps keep their old colours.

set -euo pipefail

MARKER=$HOME/.config/omarchy/gtk-theme
COLORS=${OMARCHY_GTK_THEME_COLORS:-$HOME/.local/state/omarchy/current/theme/colors.toml}
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
NAME=omarchy-theme.css
BEGIN="/* omarchy-gtk-theme begin */"
END="/* omarchy-gtk-theme end */"
# First line of the gtk.css the previous version wrote whole.
OLD_HEADER="/* Generated by omarchy-gtk-theme from the Omarchy theme."

gsettings_set() {
  [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v gsettings >/dev/null || return 0
  [[ $(gsettings get org.gnome.desktop.interface "$1" 2>/dev/null) == "'$2'" ]] ||
    gsettings set org.gnome.desktop.interface "$1" "$2"
}

has_adw_gtk3() {
  local dir
  for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/themes" "$HOME/.themes" /usr/share/themes; do
    [[ -d $dir/adw-gtk3 ]] && return 0
  done
  return 1
}

# Take our block out of a gtk.css, keeping everything else as it is. A file the
# previous version wrote whole keeps only the blocks other tools added to it.
remove_import() {
  local css=$1
  [[ -f $css ]] || return 0
  if head -1 "$css" | grep -qF "$OLD_HEADER"; then
    sed -n '/^\/\* omarchy-glass begin/,/^\/\* omarchy-glass end \*\/$/p' "$css" >"$css.tmp.$$"
    mv -f "$css.tmp.$$" "$css"
  fi
  grep -qF "$BEGIN" "$css" || return 0
  sed "\\|^/\\* omarchy-gtk-theme begin \\*/\$|,\\|^/\\* omarchy-gtk-theme end \\*/\$|d" "$css" >"$css.tmp.$$"
  mv -f "$css.tmp.$$" "$css"
}

# Put our block first in gtk.css: @import has to come before any rule.
add_import() {
  local css=$1
  mkdir -p "$(dirname "$css")"
  remove_import "$css"
  {
    printf '%s\n@import url("file://%s");\n%s\n' "$BEGIN" "$(dirname "$css")/$NAME" "$END"
    [[ -f $css ]] && cat "$css"
  } >"$css.tmp.$$"
  mv -f "$css.tmp.$$" "$css"
}

# Write via a temp file and rename, so an app starting mid-write never reads
# half a stylesheet.
write_file() {
  mkdir -p "$(dirname "$1")"
  printf '%s\n' "$2" >"$1.tmp.$$"
  mv -f "$1.tmp.$$" "$1"
}

force=0
for arg in "$@"; do
  case $arg in
    --force) force=1 ;;
    --off)
      rm -f "$MARKER"
      for v in 3.0 4.0; do
        remove_import "$CONFIG/gtk-$v/gtk.css"
        rm -f "$CONFIG/gtk-$v/$NAME"
      done
      mode=$(omarchy-theme-color --file "$COLORS" mode 2>/dev/null || echo dark)
      [[ $mode == light ]] && gsettings_set gtk-theme Adwaita || gsettings_set gtk-theme Adwaita-dark
      exit 0
      ;;
    *) echo "Usage: omarchy-gtk-theme [--force] [--off]" >&2; exit 1 ;;
  esac
done

((force)) || [[ -e $MARKER ]] || exit 0
[[ -f $COLORS ]] || exit 0

# ── palette ────────────────────────────────────────────────────────────────

toml_value() {
  sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\\(#[0-9A-Fa-f]\\{6\\}\\)\".*/\\1/p" "$COLORS" | head -1
}

colour() {
  local key val
  for key in "$@"; do
    [[ $key == \#* ]] && { echo "$key"; return; }
    val=$(toml_value "$key")
    [[ -n $val ]] && { echo "${val,,}"; return; }
  done
}

# Same mode Omarchy itself uses (mode key, light.mode marker or luminance).
mode=$(omarchy-theme-color --file "$COLORS" mode 2>/dev/null || true)
[[ $mode == light ]] || mode=dark

bg=$(colour background "#1e1e2e")
fg=$(colour foreground "#cdd6f4")
alt=$(colour dark_background background "#181825")
accent=$(colour accent blue "#89b4fa")
red=$(colour red "#f38ba8")
green=$(colour green "#a6e3a1")
yellow=$(colour yellow "#f9e2af")
warning=$(colour orange yellow "#fab387")

# Black or white text on a colour, whichever has the higher WCAG contrast.
on() {
  awk -v c="$1" -v dark="$2" -v light="$3" 'function lin(x) { x /= 255; return x <= 0.04045 ? x / 12.92 : ((x + 0.055) / 1.055) ^ 2.4 }
  BEGIN {
    l = 0.2126 * lin(strtonum("0x" substr(c, 2, 2))) + 0.7152 * lin(strtonum("0x" substr(c, 4, 2))) + 0.0722 * lin(strtonum("0x" substr(c, 6, 2)))
    print ((1.05 / (l + 0.05)) >= ((l + 0.05) / 0.05)) ? light : dark
  }'
}
on4() { on "$1" "rgb(0 0 6 / 80%)" "#ffffff"; }
on3() { on "$1" "rgba(0, 0, 6, 0.8)" "#ffffff"; }

rounding=$(hyprctl -j getoption decoration:rounding 2>/dev/null | grep -oP '"int":\s*\K\d+' || true)
rounding=${rounding:-0}

# Mode-dependent surfaces and shades, after libadwaita's _colors.scss.
if [[ $mode == dark ]]; then
  view4=$alt
  raised4="color-mix(in srgb, $bg 92%, $fg)"
  card4="color-mix(in srgb, $fg 6%, transparent)"
  toggle4="color-mix(in srgb, $fg 20%, transparent)"
  shade4="rgb(0 0 6 / 25%)"
  strong_shade4="rgb(0 0 6 / 36%)"
  darker_shade4="rgb(0 0 12 / 90%)"
  outline4="rgb(0 0 12 / 95%)"

  view3=$alt
  raised3="mix($bg, $fg, 0.08)"
  card3="alpha($fg, 0.06)"
  shade3="rgba(0, 0, 6, 0.25)"
  strong_shade3="rgba(0, 0, 6, 0.36)"
  darker_shade3="rgba(0, 0, 12, 0.9)"
  outline3="rgba(0, 0, 12, 0.95)"
  # adw-gtk3's standalone colours: lighter in dark mode
  standalone3() { echo "mix($1, white, 0.4)"; }
else
  view4="color-mix(in srgb, $bg 50%, white)"
  raised4=$view4
  card4=$view4
  toggle4=$view4
  shade4="rgb(0 0 6 / 7%)"
  strong_shade4="rgb(0 0 6 / 12%)"
  darker_shade4="rgb(0 0 6 / 12%)"
  outline4="white"

  view3="mix($bg, white, 0.5)"
  raised3=$view3
  card3=$view3
  shade3="rgba(0, 0, 6, 0.07)"
  strong_shade3="rgba(0, 0, 6, 0.12)"
  darker_shade3="rgba(0, 0, 6, 0.12)"
  outline3="white"
  standalone3() { echo "mix($1, black, 0.17)"; }
fi

header() {
  cat <<EOF
/* omarchy-gtk-theme: generated from $COLORS ($mode).
   Overwritten on every theme switch; turn off with omarchy-gtk-theme --off,
   and put your own rules in gtk.css below the import block. */
EOF
}

# Corners follow Hyprland's decoration:rounding. Shapes that mean something
# (round checks and radios, pill switches, circular buttons) keep their shape.
shape_css() {
  cat <<EOF

/* Corners: Hyprland decoration:rounding = ${rounding}px */
window,
decoration,
button,
entry,
spinbutton,
dropdown > button,
combobox > box > button,
popover > contents,
popover.menu > contents,
menu,
.menu,
tooltip,
.card,
list.boxed-list,
list > row,
row.activatable,
toast,
.app-notification,
.osd,
.toolbar,
searchbar > revealer > box,
.nautilus-pathbar,
.nautilus-pathbar > scrolledwindow undershoot,
.nautilus-path-button,
.floating-bar,
.nautilus-grid-view gridview > child,
.nautilus-grid-view .nautilus-view-cell,
.nautilus-list-view columnview > listview > row,
.nautilus-network-view listview > row,
.image-frame,
rubberband {
  border-radius: ${rounding}px;
}

/* Joined groups are drawn as one shape: only their outer corners round */
.linked > button,
.linked > entry,
.linked > dropdown > button,
.linked > menubutton > button {
  border-radius: 0;
}
.linked:not(.vertical) > :first-child,
.linked:not(.vertical) > :first-child > button {
  border-top-left-radius: ${rounding}px;
  border-bottom-left-radius: ${rounding}px;
}
.linked:not(.vertical) > :last-child,
.linked:not(.vertical) > :last-child > button {
  border-top-right-radius: ${rounding}px;
  border-bottom-right-radius: ${rounding}px;
}

/* Shapes that carry meaning stay as they are */
radio,
check,
.radio,
.check,
button.circular,
button.osd.circular {
  border-radius: 9999px;
}
switch,
switch slider,
button.pill {
  border-radius: 9999px;
}
EOF
}

gtk4_css() {
  header
  cat <<EOF

:root {
  --accent-bg-color: $accent;
  --accent-fg-color: $(on4 "$accent");
  --destructive-bg-color: $red;
  --destructive-fg-color: $(on4 "$red");
  --error-bg-color: $red;
  --error-fg-color: $(on4 "$red");
  --success-bg-color: $green;
  --success-fg-color: $(on4 "$green");
  --warning-bg-color: $warning;
  --warning-fg-color: $(on4 "$warning");

  --window-bg-color: $bg;
  --window-fg-color: $fg;
  --view-bg-color: $view4;
  --view-fg-color: $fg;

  --headerbar-bg-color: $bg;
  --headerbar-fg-color: $fg;
  --headerbar-border-color: $fg;
  --headerbar-backdrop-color: $bg;
  --headerbar-shade-color: $strong_shade4;
  --headerbar-darker-shade-color: $darker_shade4;

  --sidebar-bg-color: $alt;
  --sidebar-fg-color: $fg;
  --sidebar-backdrop-color: $alt;
  --sidebar-border-color: $strong_shade4;
  --sidebar-shade-color: $shade4;

  --secondary-sidebar-bg-color: color-mix(in srgb, $bg 50%, $alt);
  --secondary-sidebar-fg-color: $fg;
  --secondary-sidebar-backdrop-color: color-mix(in srgb, $bg 50%, $alt);
  --secondary-sidebar-border-color: $strong_shade4;
  --secondary-sidebar-shade-color: $shade4;

  --card-bg-color: $card4;
  --card-fg-color: $fg;
  --card-shade-color: $strong_shade4;

  --dialog-bg-color: $raised4;
  --dialog-fg-color: $fg;
  --popover-bg-color: $raised4;
  --popover-fg-color: $fg;
  --popover-shade-color: $shade4;
  --thumbnail-bg-color: $raised4;
  --thumbnail-fg-color: $fg;

  --overview-bg-color: $alt;
  --overview-fg-color: $fg;
  --active-toggle-bg-color: $toggle4;
  --active-toggle-fg-color: $fg;

  --shade-color: $shade4;
  --scrollbar-outline-color: $outline4;
}
EOF
  shape_css
}

gtk3_css() {
  header
  cat <<EOF

/* adw-gtk3 (libadwaita's colour names) */
@define-color accent_bg_color $accent;
@define-color accent_fg_color $(on3 "$accent");
@define-color accent_color $(standalone3 "$accent");
@define-color destructive_bg_color $red;
@define-color destructive_fg_color $(on3 "$red");
@define-color destructive_color $(standalone3 "$red");
@define-color error_bg_color $red;
@define-color error_fg_color $(on3 "$red");
@define-color error_color $(standalone3 "$red");
@define-color success_bg_color $green;
@define-color success_fg_color $(on3 "$green");
@define-color success_color $(standalone3 "$green");
@define-color warning_bg_color $warning;
@define-color warning_fg_color $(on3 "$warning");
@define-color warning_color $(standalone3 "$warning");

@define-color window_bg_color $bg;
@define-color window_fg_color $fg;
@define-color view_bg_color $view3;
@define-color view_fg_color $fg;

@define-color headerbar_bg_color $bg;
@define-color headerbar_fg_color $fg;
@define-color headerbar_border_color $fg;
@define-color headerbar_backdrop_color $bg;
@define-color headerbar_shade_color $strong_shade3;
@define-color headerbar_darker_shade_color $darker_shade3;

@define-color sidebar_bg_color $alt;
@define-color sidebar_fg_color $fg;
@define-color sidebar_backdrop_color $alt;
@define-color sidebar_border_color $strong_shade3;
@define-color sidebar_shade_color $shade3;

@define-color card_bg_color $card3;
@define-color card_fg_color $fg;
@define-color card_shade_color $strong_shade3;

@define-color dialog_bg_color $raised3;
@define-color dialog_fg_color $fg;
@define-color popover_bg_color $raised3;
@define-color popover_fg_color $fg;
@define-color popover_shade_color $shade3;
@define-color thumbnail_bg_color $raised3;
@define-color thumbnail_fg_color $fg;

@define-color shade_color $shade3;
@define-color scrollbar_outline_color $outline3;

/* Stock Adwaita for GTK 3 (when adw-gtk3 is not installed) */
@define-color theme_bg_color @window_bg_color;
@define-color theme_fg_color @window_fg_color;
@define-color theme_base_color @view_bg_color;
@define-color theme_text_color @view_fg_color;
@define-color theme_selected_bg_color @accent_bg_color;
@define-color theme_selected_fg_color @accent_fg_color;
@define-color theme_unfocused_bg_color @window_bg_color;
@define-color theme_unfocused_fg_color @window_fg_color;
@define-color theme_unfocused_base_color @view_bg_color;
@define-color theme_unfocused_text_color @view_fg_color;
@define-color theme_unfocused_selected_bg_color @accent_bg_color;
@define-color theme_unfocused_selected_fg_color @accent_fg_color;
@define-color insensitive_bg_color mix(@window_bg_color, @view_bg_color, 0.4);
@define-color borders mix(@window_bg_color, @window_fg_color, 0.15);
@define-color unfocused_borders @borders;
EOF
  shape_css
}

for v in 3.0 4.0; do
  css=$(if [[ $v == 3.0 ]]; then gtk3_css; else gtk4_css; fi)
  write_file "$CONFIG/gtk-$v/$NAME" "$css"
  add_import "$CONFIG/gtk-$v/gtk.css"
done

# GTK 3 apps take libadwaita's look and the colours above from adw-gtk3.
if has_adw_gtk3; then
  [[ $mode == light ]] && gsettings_set gtk-theme adw-gtk3 || gsettings_set gtk-theme adw-gtk3-dark
fi
