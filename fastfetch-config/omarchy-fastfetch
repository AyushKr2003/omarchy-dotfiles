#!/usr/bin/env bash
# omarchy-fastfetch — theme-aware fastfetch launcher for omarchy-shell
#
# Reads the current omarchy theme's colors.toml, converts the hex palette to
# ANSI true-color escape codes, then injects them as a temporary fastfetch
# config with live gradient section headers.
#
# Usage:
#   omarchy-fastfetch          # normal run
#   omarchy-fastfetch --help   # pass any flags through to fastfetch
#
# Install: cp omarchy-fastfetch ~/.local/bin/ && chmod +x ~/.local/bin/omarchy-fastfetch

set -euo pipefail

COLORS_FILE="${HOME}/.config/omarchy/current/theme/colors.toml"
CONFIG_FILE="/home/shadow/omarchy-dotfiles/fastfetch-config/config.jsonc"
TMPDIR="${TMPDIR:-/tmp}"
TMP_CONFIG="${TMPDIR}/omarchy-fastfetch-$$.jsonc"

# ── hex_to_ansi: convert #rrggbb → \e[38;2;R;G;Bm\e[1m ───────────────────────
hex_to_ansi() {
  local hex="${1#\#}"
  local r g b
  r=$((16#${hex:0:2}))
  g=$((16#${hex:2:2}))
  b=$((16#${hex:4:2}))
  printf '\033[38;2;%d;%d;%dm\033[1m' "$r" "$g" "$b"
}

# ── read_color: grep a key from colors.toml ───────────────────────────────────
read_color() {
  local key="$1"
  grep -m1 "^${key}\s*=" "$COLORS_FILE" 2>/dev/null \
    | sed 's/.*=\s*"\(#[0-9a-fA-F]*\)".*/\1/' \
    | tr -d '[:space:]'
}

# ── Build palette from current theme ─────────────────────────────────────────
if [[ -f "$COLORS_FILE" ]]; then
  C_ACCENT=$(hex_to_ansi "$(read_color accent)")
  C_C4=$(hex_to_ansi "$(read_color color4)")     # blue family
  C_C6=$(hex_to_ansi "$(read_color color6)")     # cyan family
  C_C2=$(hex_to_ansi "$(read_color color2)")     # green family
  C_C3=$(hex_to_ansi "$(read_color color3)")     # yellow family
  C_C5=$(hex_to_ansi "$(read_color color5)")     # magenta/purple
  C_C1=$(hex_to_ansi "$(read_color color1)")     # red family
  C_C7=$(hex_to_ansi "$(read_color color7)")     # light fg
  C_FG=$(hex_to_ansi "$(read_color foreground)") # primary fg
  C_DIM=$(hex_to_ansi "$(read_color color8)")    # dim/muted
else
  # Fallback: use omarchy default Tokyo Night accent colors
  C_ACCENT=$(printf '\033[38;2;122;162;247m\033[1m')
  C_C4=$(printf '\033[38;2;122;162;247m\033[1m')
  C_C6=$(printf '\033[38;2;68;157;171m\033[1m')
  C_C2=$(printf '\033[38;2;158;206;106m\033[1m')
  C_C3=$(printf '\033[38;2;224;175;104m\033[1m')
  C_C5=$(printf '\033[38;2;173;142;230m\033[1m')
  C_C1=$(printf '\033[38;2;247;118;142m\033[1m')
  C_C7=$(printf '\033[38;2;120;124;153m\033[1m')
  C_FG=$(printf '\033[38;2;169;177;214m\033[1m')
  C_DIM=$(printf '\033[38;2;68;75;106m\033[1m')
fi

R='\033[0m'

# ── Gradient border builder ───────────────────────────────────────────────────
# Produces a 57-char wide box top/bottom in theme gradient
grad_top() {
  local label="$1"
  local pad=$(( (43 - ${#label}) / 2 ))
  local lpad rpad
  lpad=$(printf '─%.0s' $(seq 1 $pad))
  rpad=$(printf '─%.0s' $(seq 1 $(( 43 - ${#label} - pad ))))
  printf "${C_ACCENT}╭${C_C4}──${C_C6}──${C_C2}──${C_C3}──${C_C5}──${C_C1}──${C_C7}──${C_FG}${lpad} ${label} ${rpad}${C_DIM}──${C_C7}──${C_C1}──${C_C5}──${C_C3}──${C_C2}──${C_C6}──${C_C4}──${C_ACCENT}╮${R}\n"
}

grad_bot() {
  printf "${C_DIM}╰$(printf '─%.0s' $(seq 1 57))╯${R}\n"
}

# ── Emit section-colored key prefix ──────────────────────────────────────────
sec() { printf "${1}│${R}"; }

# ── Build temporary config with runtime-colored headers ──────────────────────
HW_TOP=$(grad_top "Hardware")
SW_TOP=$(grad_top "Software")
CN_TOP=$(grad_top "Connectivity")
TM_TOP=$(grad_top "Time & Age")
BOT=$(grad_bot)
BL="${C_C4}│${R}"   # hardware section pipe color (blue)
PU="${C_C5}│${R}"   # software section (purple)
CY="${C_C6}│${R}"   # connectivity (cyan)
YE="${C_C3}│${R}"   # time (yellow)

# Write a minimal override config that replaces only the box-drawing custom
# modules; everything else is inherited from the main config.
# We do this by writing a full standalone config so we don't depend on fastfetch
# include support (not all versions have it).

python3 - <<PYEOF
import json, sys

with open("$CONFIG_FILE") as f:
    raw = f.read()

# Strip JS-style // comments (fastfetch's own parser handles them but python json won't)
import re
stripped = re.sub(r'//[^\n]*', '', raw)
cfg = json.loads(stripped)

# Replace custom format strings with the live-colored versions
replacements = {
    "Hardware":      r"""$HW_TOP""",
    "Software":      r"""$SW_TOP""",
    "Connectivity":  r"""$CN_TOP""",
    "Time & Age":    r"""$TM_TOP""",
}
for mod in cfg.get("modules", []):
    if isinstance(mod, dict) and mod.get("type") == "custom":
        fmt = mod.get("format", "")
        for label, colored in replacements.items():
            if label in fmt and "╭" in fmt:
                mod["format"] = colored
                break
            if "╰" in fmt:
                mod["format"] = r"""$BOT"""
                break

# Fix key colors to use live theme pipe characters
pipe_map = {
    r'\u001b[34m│\u001b[0m': r"""$BL""",
    r'\u001b[35m│\u001b[0m': r"""$PU""",
    r'\u001b[36m│\u001b[0m': r"""$CY""",
    r'\u001b[33m│\u001b[0m': r"""$YE""",
}
for mod in cfg.get("modules", []):
    if isinstance(mod, dict) and "key" in mod:
        for old, new in pipe_map.items():
            if old in mod["key"]:
                mod["key"] = mod["key"].replace(old, new)

with open("$TMP_CONFIG", "w") as f:
    json.dump(cfg, f, ensure_ascii=False, indent=2)

print("ok", file=sys.stderr)
PYEOF

# ── Run fastfetch with the temp config ────────────────────────────────────────
trap 'rm -f "$TMP_CONFIG"' EXIT
fastfetch --config "$TMP_CONFIG" "$@"
