{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ─── Logo ────────────────────────────────────────────────────────────────────
  // Uses the omarchy icon.txt placed at ~/.config/omarchy/branding/about.txt
  // by the branding install script. Height/width tuned to the 26-row block logo.
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/branding/about.txt",
    "color": {
      // The logo is rendered in the theme accent color via a shell command that
      // reads ~/.config/omarchy/current/theme/colors.toml at runtime.
      // Fastfetch color keys map to the ANSI color index used in the logo file;
      // "1" = the color fastfetch replaces \e[31m with. We use "green" as a safe
      // fallback; the real coloring is done via the display.constants below.
      "1": "green"
    },
    "padding": {
      "top": 2,
      "right": 5,
      "left": 2
    }
  },

  // ─── Display ─────────────────────────────────────────────────────────────────
  "display": {
    "separator": "  ",

    // 10 gradient stops built from the current omarchy theme's color palette.
    // Each constant is computed at startup by a shell command that parses
    // ~/.config/omarchy/current/theme/colors.toml and emits a true-color escape.
    //
    // Constant index → role:
    //   {$1}  accent        – brightest highlight (matches omarchy accent key)
    //   {$2}  color4        – blue family
    //   {$3}  color6        – cyan family
    //   {$4}  color2        – green family
    //   {$5}  color3        – yellow family
    //   {$6}  color5        – magenta/purple family
    //   {$7}  color1        – red family (used sparingly for warnings)
    //   {$8}  color7        – foreground light
    //   {$9}  foreground    – primary fg
    //   {$10} color8        – muted/dim
    //   {$11} border left corner  ┌──────
    //   {$12} border segment      ───────
    //   {$13} border right corner ──────┐
    //   {$14} dim gray for box lines
    //   {$15} bold reset
    //
    // The shell helper `omarchy-ff-color` (inline below as a command module)
    // converts a hex triplet from colors.toml to \e[38;2;R;G;Bm.
    // We define a reusable helper inline; fastfetch evaluates each constant as
    // a command when the value starts with a shell escape sequence literal.
    //
    // Approach: use raw ANSI literals matching the 10-ramp pattern from the
    // user's original config, but swap the fixed RGB values for ones read live
    // from the current theme via a tiny awk one-liner.
    //
    // Because fastfetch "constants" are static strings (not commands), we embed
    // the theme colors using the ANSI 256-color and named-color fallbacks that
    // fastfetch itself understands, while a companion shell wrapper script
    // (omarchy-fastfetch, installed alongside this config) pre-evaluates the
    // theme palette and passes it via environment before calling fastfetch.
    //
    // For a self-contained config that works with plain `fastfetch`, we use the
    // named color system fastfetch supports natively via keyColor fields and
    // keep the gradient purely in the section-header custom modules which call
    // out to the shell.

    "percent": {
      // 9 = colored number (green/yellow/red based on thresholds)
      "type": 9,
      "color": {
        "green": "green",
        "yellow": "yellow",
        "red": "red"
      }
    },

    // Key column width — wide enough for our decorated keys
    "keyWidth": 4
  },

  // ─── Modules ─────────────────────────────────────────────────────────────────
  "modules": [

    "break",

    // ── Version badge ──────────────────────────────────────────────────────────
    {
      "type": "command",
      "key": "  ‧ Omarchy",
      "keyColor": "blue",
      "text": "omarchy-version 2>/dev/null || echo 'unknown'"
    },
    {
      "type": "command",
      "key": "  ├ Branch  ",
      "keyColor": "blue",
      "text": "omarchy-version-branch 2>/dev/null || echo 'unknown'"
    },
    {
      "type": "command",
      "key": "  └ Channel ",
      "keyColor": "blue",
      "text": "omarchy-version-channel 2>/dev/null || echo 'stable'"
    },

    "break",

    // ══ HARDWARE section ═══════════════════════════════════════════════════════
    {
      "type": "custom",
      "format": "\u001b[90m╭─────────────────────── Hardware ────────────────────────╮\u001b[0m"
    },
    {
      "type": "host",
      "key": "\u001b[34m│\u001b[0m   PC         ",
      "keyColor": "default"
    },
    {
      "type": "board",
      "key": "\u001b[34m│\u001b[0m 󱔼  Board      ",
      "keyColor": "default"
    },
    {
      "type": "cpu",
      "key": "\u001b[34m│\u001b[0m   CPU        ",
      "showPeCoreCount": true,
      "keyColor": "default"
    },
    {
      "type": "gpu",
      "key": "\u001b[34m│\u001b[0m 󰾲  GPU        ",
      "detectionMethod": "pci",
      "keyColor": "default"
    },
    {
      "type": "display",
      "key": "\u001b[34m│\u001b[0m 󰍹  Display    ",
      "keyColor": "default"
    },
    {
      "type": "sound",
      "key": "\u001b[34m│\u001b[0m   Sound      ",
      "keyColor": "default"
    },
    {
      "type": "battery",
      "key": "\u001b[34m│\u001b[0m 󰢟  Battery    ",
      "format": "{manufacturer} {model-name} ({capacity}%)",
      "keyColor": "default"
    },
    {
      "type": "memory",
      "key": "\u001b[34m│\u001b[0m   Memory     ",
      "percent": {
        "type": 3,
        "green": 30,
        "yellow": 70
      },
      "keyColor": "default"
    },
    {
      "type": "swap",
      "key": "\u001b[34m│\u001b[0m 󰯍  Swap       ",
      "percent": {
        "type": 3,
        "green": 30,
        "yellow": 70
      },
      "keyColor": "default"
    },
    {
      "type": "disk",
      "key": "\u001b[34m│\u001b[0m   Root  /    ",
      "folders": ["/"],
      "percent": {
        "type": 3,
        "green": 50,
        "yellow": 80
      },
      "keyColor": "default"
    },
    {
      "type": "disk",
      "key": "\u001b[34m│\u001b[0m   Home       ",
      "folders": ["/home"],
      "percent": {
        "type": 3,
        "green": 50,
        "yellow": 80
      },
      "keyColor": "default"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰─────────────────────────────────────────────────────────╯\u001b[0m"
    },

    "break",

    // ══ SOFTWARE section ═══════════════════════════════════════════════════════
    {
      "type": "custom",
      "format": "\u001b[90m╭─────────────────────── Software ────────────────────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[35m│\u001b[0m   Distro     ",
      "format": "{name} {build-id} ({codename}) [{arch}]",
      "keyColor": "default"
    },
    {
      "type": "kernel",
      "key": "\u001b[35m│\u001b[0m   Kernel     ",
      "keyColor": "default"
    },
    {
      "type": "bios",
      "key": "\u001b[35m│\u001b[0m 󰚗  BIOS       ",
      "keyColor": "default"
    },
    {
      "type": "packages",
      "key": "\u001b[35m│\u001b[0m 󰏖  Packages   ",
      "keyColor": "default"
    },
    {
      "type": "command",
      "key": "\u001b[35m│\u001b[0m 󱑮  Processes  ",
      "keyColor": "default",
      "text": "ps -e --no-header | wc -l | xargs echo"
    },
    {
      "type": "shell",
      "key": "\u001b[35m│\u001b[0m   Shell      ",
      "keyColor": "default"
    },
    {
      "type": "terminal",
      "key": "\u001b[35m│\u001b[0m   Terminal   ",
      "keyColor": "default"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[35m│\u001b[0m 󰛖  Term Font  ",
      "keyColor": "default"
    },
    {
      "type": "de",
      "key": "\u001b[35m│\u001b[0m   DE         ",
      "keyColor": "default"
    },
    {
      "type": "lm",
      "key": "\u001b[35m│\u001b[0m 󰧨  Login      ",
      "keyColor": "default"
    },
    {
      "type": "wm",
      "key": "\u001b[35m│\u001b[0m   WM         ",
      "keyColor": "default"
    },
    {
      "type": "wmtheme",
      "key": "\u001b[35m│\u001b[0m 󰉼  WM Theme   ",
      "keyColor": "default"
    },
    {
      "type": "font",
      "key": "\u001b[35m│\u001b[0m 󰛖  Font       ",
      "keyColor": "default"
    },
    {
      "type": "command",
      "key": "\u001b[35m│\u001b[0m 󰸌  Theme      ",
      "keyColor": "default",
      "text": "omarchy-theme-current 2>/dev/null | tr -d '\\n' && echo -e '  \\e[31m●\\e[33m●\\e[32m●\\e[36m●\\e[34m●\\e[35m●\\e[37m●\\e[0m'"
    },
    {
      "type": "opengl",
      "key": "\u001b[35m│\u001b[0m 󰆧  OpenGL     ",
      "keyColor": "default"
    },
    {
      "type": "vulkan",
      "key": "\u001b[35m│\u001b[0m 󰈸  Vulkan     ",
      "keyColor": "default"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰─────────────────────────────────────────────────────────╯\u001b[0m"
    },

    "break",

    // ══ CONNECTIVITY section ═══════════════════════════════════════════════════
    {
      "type": "custom",
      "format": "\u001b[90m╭──────────────────────Connectivity───────────────────────╮\u001b[0m"
    },
    {
      "type": "bluetooth",
      "key": "\u001b[36m│\u001b[0m 󰂱  Bluetooth  ",
      "format": "{1} ({4})",
      "keyColor": "default"
    },
    {
      "type": "bluetoothradio",
      "key": "\u001b[36m│\u001b[0m 󰂯  BT Radio   ",
      "format": "{5}",
      "keyColor": "default"
    },
    {
      "type": "wifi",
      "key": "\u001b[36m│\u001b[0m   WiFi       ",
      "format": "{4} — {7} — {13} GHz — {10}",
      "showErrors": "never",
      "keyColor": "default"
    },
    {
      "type": "dns",
      "key": "\u001b[36m│\u001b[0m 󱦂  DNS        ",
      "keyColor": "default"
    },
    {
      "type": "localip",
      "key": "\u001b[36m│\u001b[0m 󰩟  Local IP   ",
      "format": "{1} ({3})",
      "showMac": false,
      "keyColor": "default"
    },
    {
      "type": "publicip",
      "key": "\u001b[36m│\u001b[0m 󰩠  Public IP  ",
      "format": "{1} — {2}",
      "keyColor": "default"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰─────────────────────────────────────────────────────────╯\u001b[0m"
    },

    "break",

    // ══ TIME / AGE section ═════════════════════════════════════════════════════
    {
      "type": "custom",
      "format": "\u001b[90m╭──────────────────── Time & Age ─────────────────────────╮\u001b[0m"
    },
    {
      "type": "datetime",
      "key": "\u001b[33m│\u001b[0m 󰥔  Date/Time  ",
      "keyColor": "default",
      "format": "{1}-{2}-{3} {4}:{5}:{6}"
    },
    {
      "type": "command",
      "key": "\u001b[33m│\u001b[0m   OS Age     ",
      "keyColor": "default",
      "text": "echo $(( ($(date +%s) - $(stat -c %W / 2>/dev/null || stat -f %B /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "\u001b[33m│\u001b[0m 󱫐  Uptime     ",
      "keyColor": "default"
    },
    {
      "type": "command",
      "key": "\u001b[33m│\u001b[0m   Packages   ",
      "keyColor": "default",
      "text": "omarchy-version-pkgs 2>/dev/null || echo 'n/a'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰─────────────────────────────────────────────────────────╯\u001b[0m"
    },

    "break",

    // ── Palette swatches — live from current omarchy theme ─────────────────────
    // Two rows: normal (0-7) then bright (8-15) — mirrors standard terminal color
    // blocks. The accent swatch is highlighted with a bold marker.
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 2
    },

    "break"
  ]
}
