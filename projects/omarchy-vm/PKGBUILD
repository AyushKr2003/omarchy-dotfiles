# omarchy-vm

pkgname=omarchy-vm
pkgver=0.2.6
pkgrel=3
pkgdesc="Multi-distro VM launcher with optional Omarchy integration (local build, quattro branch)"
arch=('x86_64')
url="https://github.com/Ayushkr2003/omarchy-dotfiles"
license=('MIT')
depends=(
  'bash'
  'coreutils'
  'curl'
  'docker'
  'e2fsprogs'
  'gnupg'
  'gum'
  'libnotify'
  'sudo'
  'virt-viewer'
)
makedepends=('git')
source=()
sha256sums=()

package() {
  cd "${startdir}"

  install -Dm755 "bin/omarchy-kali-vm" "${pkgdir}/usr/bin/omarchy-kali-vm"
  install -Dm755 "bin/omarchy-vm-integrate-os" "${pkgdir}/usr/bin/omarchy-vm-integrate-os"
  install -Dm755 "bin/omarchy-vm-unintegrate-os" "${pkgdir}/usr/bin/omarchy-vm-unintegrate-os"
  install -Dm755 "bin/omarchy-parrot-vm" "${pkgdir}/usr/bin/omarchy-parrot-vm"
  install -Dm755 "bin/omarchy-arch-vm" "${pkgdir}/usr/bin/omarchy-arch-vm"
  install -Dm755 "bin/omarchy-nixos-vm" "${pkgdir}/usr/bin/omarchy-nixos-vm"
  install -Dm755 "bin/omarchy-vm" "${pkgdir}/usr/bin/omarchy-vm"

  install -Dm644 "assets/icons/kali.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/omarchy-kali-vm.png"
  install -Dm644 "assets/icons/parrot.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/omarchy-parrot-vm.png"
  install -Dm644 "assets/icons/arch.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/omarchy-arch-vm.png"
  install -Dm644 "assets/icons/nixos.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/omarchy-nixos-vm.png"

  install -Dm644 "share/hypr/omarchy-vm.lua" "${pkgdir}/usr/share/omarchy-vm/hypr/omarchy-vm.lua"

  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "docs/cleanup.md" "${pkgdir}/usr/share/doc/${pkgname}/cleanup.md"
  install -Dm644 "docs/integration.md" "${pkgdir}/usr/share/doc/${pkgname}/integration.md"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
