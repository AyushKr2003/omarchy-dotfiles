# fievel — keyboard-driven mouse (https://github.com/MontyTheSoftwareEngineer/fievel)
# Replaces the old ydotool `cursor` submap in hypr/bindings.lua.
# Omitted settings keep fievel's built-in defaults. Restart to reload:
#   systemctl --user restart fievel
mode = "toggle" # Super+Ctrl+M on, Super+Ctrl+M off (like the old submap)
notify = true   # Faint "fievel" box bottom-left while mouse mode is on
home_end_enabled = true

[speeds]
normal = 300
slow = 100
fast = 900
scroll = 6
scroll_slow = 1.5
scroll_fast = 24

[easing]
movement = 0.2
scroll = 0 # Whole wheel notches; smooth sub-notch scroll never reaches tmux/terminals

# Linux keycodes. H/J/K/L move, Space/I click, N/M/,/. scroll, S fast, A slow.
[keys]
free_mouse = "leftctrl + leftmeta + m"
left = "h"
down = "j"
up = "k"
right = "l"
left_click = "space"
right_click = "i"
scroll_left = "n"
scroll_down = "m"
scroll_up = ","
scroll_right = "."
slow = "a"
fast = "s"

# Default hint keys (Super+Space / Super+I) collide with the Omacale launcher
# and Omarchy Settings, so they live on Super+Alt instead.
[hints.keys]
left = "leftmeta + leftalt + h"
right = "leftmeta + leftalt + i"
cancel = "enter"
toggle_background = "leftctrl"
debug = "f8"

# No [remap] tables: home-row chords add latency to normal typing.
