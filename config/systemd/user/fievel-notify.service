[Unit]
Description=Cursor Mode notification for fievel
PartOf=fievel.service
After=fievel.service

[Service]
ExecStart=%h/.local/bin/fievel-notify
# The listener exits cleanly when Hyprland restarts (its socket closes),
# so restart on any exit, not just failures.
Restart=always
RestartSec=2

[Install]
WantedBy=fievel.service
