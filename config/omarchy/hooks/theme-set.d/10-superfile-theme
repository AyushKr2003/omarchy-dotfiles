#!/bin/bash
# Generate a superfile theme from the current Omarchy colors.toml
set -euo pipefail

COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
SUPERFILE_THEME="$HOME/.config/superfile/theme/omarchy-live.toml"
SUPERFILE_CONFIG="$HOME/.config/superfile/config.toml"

[[ -f $COLORS ]] || exit 0

get() {
  local key=$1 default=${2:-}
  local val
  val=$(sed -n "s/^$key = \"//p" "$COLORS" | sed 's/"$//' | head -1)
  if [[ -z $val ]]; then
    local alt_key="$key"
    if [[ $key == *background* || $key == *foreground* ]]; then
      alt_key="${key/background/bg}"
      alt_key="${alt_key/foreground/fg}"
    else
      alt_key="${key/bg/background}"
      alt_key="${alt_key/fg/foreground}"
    fi
    val=$(sed -n "s/^$alt_key = \"//p" "$COLORS" | sed 's/"$//' | head -1)
  fi
  if [[ -n $val ]]; then
    echo "$val"
  else
    echo "$default"
  fi
}


bg=$(get bg "#1e1e2e")
fg=$(get fg "#cdd6f4")
dark_fg=$(get dark_fg "#6c7086")
accent=$(get accent "#89b4fa")
blue=$(get blue "$accent")
green=$(get green "#a6e3a1")
red=$(get red "#f38ba8")
magenta=$(get magenta "#cba6f7")
cyan=$(get cyan "#94e2d5")
muted=$(get muted "#585b70")
selection=$(get selection "#45475a")
light_fg=$(get light_fg "$fg")
bright_fg=$(get bright_fg "$fg")

mkdir -p "$(dirname "$SUPERFILE_THEME")"

cat > "$SUPERFILE_THEME" <<EOF
code_syntax_highlight = "catppuccin-mocha"

full_screen_fg = "$fg"
full_screen_bg = "$bg"

gradient_color = ["$blue", "$magenta"]

file_panel_fg = "$fg"
file_panel_bg = "$bg"
file_panel_border = "$dark_fg"
file_panel_border_active = "$blue"
file_panel_top_directory_icon = "$green"
file_panel_top_path = "$blue"
file_panel_item_selected_fg = "$light_fg"
file_panel_item_selected_bg = "$selection"

footer_fg = "$fg"
footer_bg = "$bg"
footer_border = "$dark_fg"
footer_border_active = "$green"

sidebar_fg = "$fg"
sidebar_bg = "$bg"
sidebar_title = "$cyan"
sidebar_border = "$bg"
sidebar_border_active = "$red"
sidebar_item_selected_fg = "$light_fg"
sidebar_item_selected_bg = "$selection"
sidebar_divider = "$muted"

modal_fg = "$fg"
modal_bg = "$bg"
modal_border_active = "$muted"
modal_cancel_fg = "$bg"
modal_cancel_bg = "$red"
modal_confirm_fg = "$bg"
modal_confirm_bg = "$cyan"

help_menu_hotkey = "$cyan"
help_menu_title = "$magenta"

cursor = "$fg"
correct = "$green"
error = "$red"
hint = "$cyan"
cancel = "$magenta"
EOF

if [[ -f $SUPERFILE_CONFIG ]]; then
  if grep -q '^theme = "omarchy-live"' "$SUPERFILE_CONFIG"; then
    : # already set
  else
    sed -i 's/^theme = .*/theme = "omarchy-live"/' "$SUPERFILE_CONFIG"
  fi
fi
