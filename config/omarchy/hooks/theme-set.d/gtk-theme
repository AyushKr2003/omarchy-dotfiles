#!/usr/bin/env bash
#
# Generates user GTK overrides (gtk.css) for GTK3 and GTK4 from the
# active Omarchy theme colors.toml and Hyprland's rounding option.
#
set -euo pipefail

COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
[[ -f $COLORS ]] || exit 0

get() {
  local key=$1 default=${2:-}
  local val
  val=$(sed -n "s/^$key = \"//p" "$COLORS" | sed 's/"$//' | head -1)
  if [[ -z $val ]]; then
    local alt_key="$key"
    if [[ $key == *background* || $key == *foreground* ]]; then
      alt_key="${key/background/bg}"
      alt_key="${alt_key/foreground/fg}"
    else
      alt_key="${key/bg/background}"
      alt_key="${alt_key/fg/foreground}"
    fi
    val=$(sed -n "s/^$alt_key = \"//p" "$COLORS" | sed 's/"$//' | head -1)
  fi
  if [[ -n $val ]]; then
    echo "$val"
  else
    echo "$default"
  fi
}

bg=$(get background "#1e1e2e")
fg=$(get foreground "#cdd6f4")
dark_bg=$(get dark_background "$bg")
accent=$(get accent "#89b4fa")
selection=$(get selection "#313244")
muted=$(get muted "#585b70")
red=$(get red "#f38ba8")
green=$(get green "#a6e3a1")
orange=$(get orange "#fab387")

rounding=$(hyprctl -j getoption decoration:rounding 2>/dev/null | grep -oP '"int":\s*\K\d+' || echo "0")

# Write GTK 3 overrides
dir3="$HOME/.config/gtk-3.0"
mkdir -p "$dir3"
cat > "$dir3/gtk.css" <<EOF
/* Generated by ~/.config/omarchy/hooks/theme-set.d/gtk-theme
   Do not edit by hand -- overwritten on the next theme switch. */

@define-color theme_bg_color $bg;
@define-color theme_fg_color $fg;
@define-color theme_base_color $dark_bg;
@define-color theme_text_color $fg;
@define-color theme_selected_bg_color $accent;
@define-color theme_selected_fg_color $bg;
@define-color theme_tooltip_bg_color $dark_bg;
@define-color theme_tooltip_fg_color $fg;
@define-color theme_unfocused_bg_color $bg;
@define-color theme_unfocused_fg_color $fg;
@define-color theme_unfocused_base_color $dark_bg;
@define-color theme_unfocused_text_color $fg;
@define-color theme_unfocused_selected_bg_color $muted;
@define-color theme_unfocused_selected_fg_color $fg;

@define-color sidebar_bg_color $dark_bg;
@define-color sidebar_fg_color $fg;
@define-color sidebar_backdrop_color $dark_bg;
@define-color sidebar_border_color $muted;
@define-color sidebar_shade_color $dark_bg;

/* Dynamic corner radius matching Hyprland rounding */
* {
    border-radius: ${rounding}px;
}

/* Maintain circularity for checkboxes and radio buttons */
radio,
check,
.radio,
.check {
    border-radius: 50%;
}

/* Maintain pill-shape for switch controls */
switch,
switch slider,
switch image {
    border-radius: 12px;
}

/* Sidebar overrides */
.navigation-sidebar,
stacksidebar,
.sidebar,
sidebar {
    background-color: $dark_bg !important;
    color: $fg !important;
}
EOF

# Write GTK 4 overrides
dir4="$HOME/.config/gtk-4.0"
mkdir -p "$dir4"
cat > "$dir4/gtk.css" <<EOF
/* Generated by ~/.config/omarchy/hooks/theme-set.d/gtk-theme
   Do not edit by hand -- overwritten on the next theme switch. */

@define-color accent_color @accent_bg_color;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $bg;
@define-color destructive_color @destructive_bg_color;
@define-color destructive_bg_color $red;
@define-color destructive_fg_color $fg;
@define-color success_color @success_bg_color;
@define-color success_bg_color $green;
@define-color success_fg_color $bg;
@define-color warning_color @warning_bg_color;
@define-color warning_bg_color $orange;
@define-color warning_fg_color $bg;
@define-color error_color @error_bg_color;
@define-color error_bg_color $red;
@define-color error_fg_color $fg;
@define-color window_bg_color $bg;
@define-color window_fg_color $fg;
@define-color view_bg_color $dark_bg;
@define-color view_fg_color $fg;
@define-color headerbar_bg_color $bg;
@define-color headerbar_fg_color $fg;
@define-color headerbar_border_color $muted;
@define-color headerbar_backdrop_color @headerbar_bg_color;
@define-color card_bg_color $dark_bg;
@define-color card_fg_color $fg;
@define-color card_border_color $muted;
@define-color popover_bg_color $bg;
@define-color popover_fg_color $fg;
@define-color popover_border_color $muted;
@define-color dialog_bg_color $bg;
@define-color dialog_fg_color $fg;

@define-color sidebar_bg_color $dark_bg;
@define-color sidebar_fg_color $fg;
@define-color sidebar_backdrop_color $dark_bg;
@define-color sidebar_border_color $muted;
@define-color sidebar_shade_color $dark_bg;

/* Dynamic corner radius matching Hyprland rounding */
* {
    border-radius: ${rounding}px;
}

/* Maintain circularity for checkboxes and radio buttons */
radio,
check,
.radio,
.check {
    border-radius: 50%;
}

/* Maintain pill-shape for switch controls */
switch,
switch slider,
switch image {
    border-radius: 12px;
}

/* Sidebar overrides */
.navigation-sidebar,
stacksidebar,
.sidebar,
sidebar {
    background-color: $dark_bg !important;
    color: $fg !important;
}
EOF

echo "omarchy-hook gtk-theme: wrote $dir3/gtk.css and $dir4/gtk.css"
