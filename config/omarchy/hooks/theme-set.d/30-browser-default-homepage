#!/bin/bash
#
# Generates ~/.config/browser-default/colors.css from the current
# Omarchy colors.toml, for the local browser-default homepage
# (~/.config/browser-default/default.html).
#
# Unlike the Firefox userChrome hook, this one has nothing to discover
# -- the homepage lives at a single fixed path this hook owns outright
# -- so it's just a straight read-colors-write-css step, no profile
# lookup involved.
set -euo pipefail

THEME_NAME="${1:-unknown}"
# Defensive: theme names are normally simple hyphenated identifiers, but
# escape backslashes/quotes before embedding into a CSS string literal
# just in case.
THEME_NAME="${THEME_NAME//\\/\\\\}"
THEME_NAME="${THEME_NAME//\"/\\\"}"

COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
DEST_DIR="$HOME/.config/browser-default"
DEST="$DEST_DIR/colors.css"

[[ -f $COLORS ]] || exit 0
mkdir -p "$DEST_DIR"

get() {
  local key=$1 default=${2:-}
  local val
  val=$(sed -n "s/^$key = \"//p" "$COLORS" | sed 's/"$//' | head -1)
  if [[ -z $val ]]; then
    local alt_key="$key"
    if [[ $key == *background* || $key == *foreground* ]]; then
      alt_key="${key/background/bg}"
      alt_key="${alt_key/foreground/fg}"
    else
      alt_key="${key/bg/background}"
      alt_key="${alt_key/fg/foreground}"
    fi
    val=$(sed -n "s/^$alt_key = \"//p" "$COLORS" | sed 's/"$//' | head -1)
  fi
  if [[ -n $val ]]; then
    echo "$val"
  else
    echo "$default"
  fi
}

mode=$(get mode "dark")
accent=$(get accent "#7aa2f7")
bg=$(get bg "#1a1b26")
dark_bg=$(get dark_bg "$bg")
darker_bg=$(get darker_bg "$dark_bg")
lighter_bg=$(get lighter_bg "$bg")
selection=$(get selection "$accent")
muted=$(get muted "#565f89")
dark_fg=$(get dark_fg "$muted")
fg=$(get fg "#a9b1d6")
light_fg=$(get light_fg "$fg")
bright_fg=$(get bright_fg "$fg")
red=$(get red "#f7768e")
yellow=$(get yellow "#e0af68")
orange=$(get orange "$yellow")
green=$(get green "#9ece6a")
cyan=$(get cyan "#7dcfff")
blue=$(get blue "#7aa2f7")
magenta=$(get magenta "#bb9af7")
brown=$(get brown "$orange")

cat >"$DEST" <<EOF
/* Generated by ~/.config/omarchy/hooks/theme-set.d/30-browser-default-homepage
   Do not edit by hand -- overwritten on the next theme switch.
   Edit style.css or default.html instead; they only read these
   variables and never hardcode a color themselves. */
:root {
  color-scheme: $mode;

  --theme-name: "$THEME_NAME";

  --bg: $bg;
  --bg-dark: $dark_bg;
  --bg-darker: $darker_bg;
  --bg-light: $lighter_bg;
  --selection: $selection;

  --fg: $fg;
  --fg-light: $light_fg;
  --fg-bright: $bright_fg;
  --fg-dim: $dark_fg;
  --muted: $muted;

  --accent: $accent;
  --red: $red;
  --yellow: $yellow;
  --orange: $orange;
  --green: $green;
  --cyan: $cyan;
  --blue: $blue;
  --magenta: $magenta;
  --brown: $brown;
}
EOF

echo "omarchy-hook browser-default-homepage: wrote $DEST"
