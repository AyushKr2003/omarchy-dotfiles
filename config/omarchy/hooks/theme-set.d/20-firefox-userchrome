  color: $fg !important;
}

.urlbarView-row:hover,
.urlbarView-row[selected],
.urlbarView-row[selected="true"] {
  background-color: $tab_selected_bg !important;
  color: $fg !important;
}

/* Zen forces every descendant of the selected row to white, which
   disappears on light themes. */
.urlbarView-row[selected] * {
  color: $fg !important;
}

.urlbarView-row .urlbarView-url {
  color: $accent !important;
}

.urlbarView-title {
  color: $fg !important;
}

.urlbarView-row .urlbarView-title-strong {
  color: $accent !important;
}

/* Override background for Manage Bookmarks, Manage History, Manage Profiles, and other footer subview buttons */
.panel-subview-footer,
.panel-subview-footer button,
.panel-subview-footer a,
.panel-subview-footer .subviewbutton,
#appMenu-library-bookmarks-showall,
#appMenu-library-history-showall,
#appMenu-fxa-container,
#appMenu-fxa-status,
