#fxa-menu-footer {
  background-color: $bg !important;
  background: $bg !important;
  color: $fg !important;
  border-top: 1px solid var(--panel-separator-color) !important;
}

/* Color theme overrides for menu/toolbar separators */
menupopup menuseparator,
panel menuseparator,
menupopup toolbarseparator,
panel toolbarseparator,
.subviewheader-separator {
  appearance: none !important;
  -moz-appearance: none !important;
  border-top: 1px solid $muted !important;
  border-bottom: none !important;
  margin: 4px 0 !important;
  padding: 0 !important;
  height: 0 !important;
}

/* Style browser modal prompt alerts */
.tabmodalprompt-container,
.tab-modal-box,
tabmodalprompt {
  background-color: $bg !important;
  color: $fg !important;
  border: 1px solid $muted !important;
  border-radius: 8px !important;
}

/* Buttons in modal prompt alerts */
.tabmodalprompt-buttonContainer button,
.tab-modal-box button {
  background-color: $tab_selected_bg !important;
  color: $fg !important;
  border: 1px solid $tab_line !important;
  border-radius: 4px !important;
  padding: 4px 12px !important;
}

.tabmodalprompt-buttonContainer button:hover,
.tab-modal-box button:hover {
  background-color: $tab_line !important;
  color: $fg !important;
}

/* Hide window controls close button */
.titlebar-close {
  display: none !important;
}

/* Style text selection inside inputs (like the URL bar) to match theme selection */
#urlbar-input::selection,
.searchbar-textbox::selection,
input::selection,
textarea::selection {
  background-color: $selection !important;
  color: $fg !important;
}
CSSEOF

  if [[ $label == Zen ]]; then
    cat >>"$chrome_dir/userChrome.css" <<CSSEOF

/* --- Zen ------------------------------------------------------------------
   Zen paints its window from its workspace gradient: JS writes
   --zen-main-browser-background(-toolbar) (plus "-old" copies used while
   cross-fading between workspaces) onto <html>, and each <zen-workspace>
   gets its own inline --zen-primary-color / --toolbox-textcolor. Inline
   styles are author-origin, so user !important wins -- but only on the
   element that declares them, hence the explicit zen-workspace target. */
:root,
#main-window,
#browser,
zen-workspace {
  --zen-main-browser-background: $bg !important;
  --zen-main-browser-background-toolbar: $bg !important;
  --zen-main-browser-background-old: $bg !important;
  --zen-main-browser-background-toolbar-old: $bg !important;
  --zen-primary-color: $accent !important;
  --toolbox-textcolor: $fg !important;
  --toolbox-textcolor-inactive: $fg !important;
  --toolbar-color: $fg !important;
  --toolbar-field-color: $fg !important;
  --toolbar-field-background-color: $dark_bg !important;
  --toolbar-color-scheme: $scheme !important;
  --zen-toolbar-element-bg: $element_bg !important;
  --zen-toolbar-element-bg-hover: $tab_hover_bg !important;
  --toolbarbutton-background-color-hover: $tab_hover_bg !important;
  --toolbarbutton-background-color-active: $tab_selected_bg !important;
  --zen-colors-border: $muted !important;
  --zen-dialog-background: $bg !important;
  --zen-urlbar-background: $element_bg !important;
  /* Zen picks light/dark from its own pref (or the workspace gradient),
     and its light-dark() overlays only match our colors if the scheme
     agrees with the Omarchy theme. */
  color-scheme: $scheme !important;
}

/* Essential (pinned-grid) tabs: unselected ones already follow
   --zen-toolbar-element-bg above. With zen.theme.essentials-favicon-bg
   on, Zen draws the selected one's background on ::before from vars it
   declares on the .tab-background itself, so override them there. */
.tabbrowser-tab[zen-essential] > .tab-stack > .tab-background {
  --zen-essential-tab-selected-bg: $tab_selected_bg !important;
  --zen-essential-tab-selected-bg-hover: $tab_selected_bg !important;
}

/* Workspace switcher and new-tab button text follow --toolbox-textcolor
   above; the sidebar splitter uses the accent button color. */
#zen-sidebar-splitter {
  --zen-accent-button-background: $accent !important;
}
CSSEOF
  else
    # Zen draws its toolbars on top of its own window background (and rounds
    # their corners); a solid fill here would only fight that.
    cat >>"$chrome_dir/userChrome.css" <<CSSEOF

#TabsToolbar, #nav-bar, #titlebar {
  background-color: $bg !important;
}
CSSEOF
  fi

  cat >"$chrome_dir/userContent.css" <<CSSEOF
/* Generated by ~/.config/omarchy/hooks/theme-set.d/20-firefox-userchrome
   Do not edit by hand -- overwritten on the next theme switch. */

@-moz-document url-prefix("moz-extension://") {
