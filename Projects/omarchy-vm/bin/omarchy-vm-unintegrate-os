#!/bin/bash
set -euo pipefail

CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"

HYPRLAND_LUA="$CONFIG_ROOT/hypr/hyprland.lua"

HYPR_MARKER_BEGIN="-- >>> omarchy-vm hypr integration >>>"
HYPR_MARKER_END="-- <<< omarchy-vm hypr integration <<<"

# Remove everything between (and including) a pair of marker lines.
# Works the same for the Lua file and the JSONC file since both use
# exact-line marker matching, independent of surrounding syntax.
remove_marker_block() {
  local file="$1"
  local begin="$2"
  local end="$3"

  [[ -f "$file" ]] || return 0

  local tmp
  tmp=$(mktemp)
  awk -v begin="$begin" -v end="$end" '
    $0 == begin { skip=1; next }
    $0 == end { skip=0; next }
    skip != 1 { print }
  ' "$file" > "$tmp"

  mv "$tmp" "$file"
}

remove_marker_block "$HYPRLAND_LUA" "$HYPR_MARKER_BEGIN" "$HYPR_MARKER_END"

printf 'Run "hyprctl reload" (or restart Hyprland) to apply.\n'
