"remove.kali": {"icon":"","label":"Kali","keywords":"vm uninstall kali-linux","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-kali-vm remove'"},
"install.parrot": {"icon":"","label":"Parrot","keywords":"vm hacking pentest parrot-os","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-parrot-vm install'"},
"remove.parrot": {"icon":"","label":"Parrot","keywords":"vm uninstall parrot-os","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-parrot-vm remove'"},
