{
  "manifest_version": 2,
  "name": "Omarchy Live Theme",
  "version": "1.0.1",
  "description": "Applies your Omarchy system theme live, via the standard browser theme API. Reads only from 127.0.0.1 and never touches page content.",
  "browser_specific_settings": {
    "gecko": {
      "id": "omarchy-live-theme@personal.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "theme",
    "storage",
    "http://127.0.0.1:47732/*",
    "http://127.0.0.1:47733/*",
    "http://127.0.0.1:47734/*",
    "http://127.0.0.1:47735/*"
  ],
  "background": {
    "scripts": [
      "theme-mapper.js",
      "theme-transport.js",
      "background.js"
    ],
    "persistent": true
  }
}
