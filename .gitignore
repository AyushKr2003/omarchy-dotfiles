# --- .local: ignore everything except the specific files below ---
.local/*
!.local/bin/
!.local/share/

# .local/bin — keep only these 4
.local/bin/*
!.local/bin/a
!.local/bin/omarchy-mount
!.local/bin/spf-mount
!.local/bin/typetui

# .local/share — only descend into applications/
.local/share/*
!.local/share/applications/

# .local/share/applications — keep only these 3 desktop files + icons/
.local/share/applications/*
!.local/share/applications/Instagram.desktop
!.local/share/applications/Reddit.desktop
!.local/share/applications/Superfile.desktop
!.local/share/applications/icons/

# .local/share/applications/icons — keep only these 3 pngs
.local/share/applications/icons/*
!.local/share/applications/icons/Instagram.png
!.local/share/applications/icons/Reddit.png
!.local/share/applications/icons/Superfile.png
